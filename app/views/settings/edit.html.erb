<% content_for :title, "Settings" %>
<h1 class="mb-6 text-xl font-semibold text-zinc-100">Settings</h1>

<div class="max-w-3xl space-y-6">
  <div class="card">
    <div class="card-header">
      <div>
        <h2 class="card-title">Status board</h2>
        <p class="text-xs text-zinc-500">A read-only page for a TV or for your team, with deploy status and server health. Anyone with the link can see it.</p>
      </div>
    </div>
    <div class="card-body space-y-4">
      <%= form_with model: @setting, url: settings_path, method: :patch, class: "flex items-center gap-3" do |form| %>
        <label class="flex items-center gap-2 text-sm"><%= form.check_box :status_board_enabled %> Enabled</label>
        <%= form.submit "Save", class: "btn btn-sm" %>
      <% end %>

      <% if @setting.status_board_enabled? %>
        <% url = status_board_url(@setting.status_board_token) %>
        <div class="flex gap-2">
          <input type="text" readonly value="<%= url %>" class="input font-mono text-xs">
          <button class="btn" data-controller="clipboard" data-clipboard-text-value="<%= url %>" data-action="clipboard#copy">Copy</button>
          <%= link_to "Open", url, target: "_blank", class: "btn" %>
        </div>
        <%= button_to "Regenerate URL", regenerate_status_board_token_settings_path, class: "btn btn-sm", form: { data: { turbo_confirm: "The current URL will stop working." } } %>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div>
        <h2 class="card-title">Server access key</h2>
        <p class="text-xs text-zinc-500">Used for every project without its own SSH key, including the apps detected on this server.</p>
      </div>
    </div>
    <div class="card-body space-y-3 text-sm">
      <% [
        [ "For the server running Kamal Web, from your Kamal Web checkout:", Setting::AUTHORIZE_THIS_SERVER ],
        [ "On any other server, as the user Kamal deploys with (usually <code>root</code>):".html_safe, @setting.authorize_command ]
      ].each do |intro, command| %>
        <p class="text-zinc-400"><%= intro %></p>
        <div class="flex gap-2">
          <input type="text" readonly value="<%= command %>" class="input font-mono text-xs">
          <button class="btn" data-controller="clipboard" data-clipboard-text-value="<%= command %>" data-action="clipboard#copy">Copy</button>
        </div>
      <% end %>
      <% if @setting.ignored_services.any? %>
        <div class="flex items-center justify-between gap-3 border-t border-zinc-800 pt-3">
          <p class="text-zinc-400">Not detected again because you removed them: <span class="font-mono text-zinc-300"><%= @setting.ignored_services.to_sentence %></span></p>
          <%= button_to "Detect again", reset_ignored_services_settings_path, class: "btn btn-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div>
        <h2 class="card-title">Backup</h2>
        <p class="text-xs text-zinc-500">Projects, encrypted variables and keys, settings and history, plus the key that decrypts them. Keep the file somewhere safe: it unlocks every secret stored here.</p>
      </div>
    </div>
    <div class="card-body space-y-4 text-sm">
      <%= link_to "Download backup", backup_path, class: "btn", data: { turbo: false } %>
      <%= form_with url: backup_path, multipart: true, class: "flex flex-wrap items-center gap-2 border-t border-zinc-800 pt-4",
        data: { turbo_confirm: "Replace everything in this instance with the backup? Kamal Web restarts to restore it." } do |form| %>
        <%= form.file_field :backup, accept: ".gz,application/gzip", required: true, class: "text-xs text-zinc-400" %>
        <%= form.submit "Restore", class: "btn btn-danger" %>
      <% end %>
      <p class="text-xs text-zinc-500">Restoring replaces the current data. What it replaces is kept in <code>storage/before-restore-*</code> in the volume.</p>
    </div>
  </div>

  <div class="card card-body text-sm text-zinc-400 space-y-1">
    <p class="font-medium text-zinc-200">Instance</p>
    <p>Kamal Web <%= KamalWeb::VERSION %> · Kamal <%= Gem.loaded_specs["kamal"]&.version %> · Rails <%= Rails.version %> · Ruby <%= RUBY_VERSION %></p>
  </div>
</div>
