<% content_for :title, @server.label %>
<%= render Ui::PageHeaderComponent.new(title: @server.label, description: (@server.host if @server.name.present?)) do %>
  <%= button_to check_server_path(@server), class: "btn btn-quiet" do %><%= render Ui::IconComponent.new(name: :refresh, size: 15) %><%= t(".check") %><% end %>
  <%= link_to t("common.edit"), edit_server_path(@server), class: "btn" %>
  <% unless @projects.any? %>
    <%= button_to t("common.delete"), server_path(@server), method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: t(".confirm_delete", name: @server.label) } } %>
  <% end %>
<% end %>

<div class="max-w-4xl space-y-6">
  <%= render Ui::PanelComponent.new do %>
    <div class="card-header">
      <h2 class="card-title"><%= t(".connection") %></h2>
      <%= render "servers/connection", server: @server %>
    </div>
    <dl class="card-body grid gap-3 text-sm sm:grid-cols-2">
      <div><dt class="label"><%= t("common.host") %></dt><dd class="font-mono break-words [overflow-wrap:anywhere]"><%= @server.host %></dd></div>
      <div><dt class="label"><%= t(".ssh") %></dt><dd class="font-mono break-words [overflow-wrap:anywhere]">ssh -p <%= @server.effective_ssh_port %> <%= @server.effective_ssh_user %>@<%= @server.host %></dd></div>
      <div><dt class="label"><%= t(".system") %></dt><dd class="break-words [overflow-wrap:anywhere]"><%= @server.system_info.presence || "–" %></dd></div>
      <div><dt class="label"><%= t(".last_check") %></dt><dd><%= @server.checked_at ? time_ago(@server.checked_at) : t(".never_checked") %></dd></div>
    </dl>
    <% connection = @server.connection %>
    <% if connection && !connection.ok %>
      <div class="border-t border-line px-4 py-4 text-sm">
        <pre class="whitespace-pre-wrap font-mono text-xs text-danger"><%= connection.error.to_s.last(500) %></pre>
        <% if (command = Setting.instance.authorize_command) %>
          <p class="mt-3 text-muted"><%= t(".authorize_html", user: tag.code(@server.effective_ssh_user)) %></p>
          <div class="mt-2 flex flex-wrap gap-2 [&>input]:min-w-0 [&>input]:flex-1 [&>input]:basis-48">
            <input type="text" readonly value="<%= command %>" class="input font-mono text-xs" aria-label="<%= t(".authorize_command") %>">
            <button class="btn" data-controller="clipboard" data-clipboard-error-value="<%= t('ui.copy_failed') %>" data-clipboard-copied-value="<%= t("common.copied") %>" data-clipboard-text-value="<%= command %>" data-action="clipboard#copy"><%= t("common.copy") %></button>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= render Ui::PanelComponent.new do %>
    <div class="card-header">
      <div>
        <h2 class="card-title"><%= t(".host_key") %></h2>
        <p class="text-xs text-muted"><%= SshHostKeys.strict? ? t(".host_key_strict") : t(".host_key_first_use") %></p>
      </div>
      <% if @host_keys.any? %>
        <%= button_to t(".forget_host_key"), forget_host_key_server_path(@server), method: :delete, class: "btn btn-sm", form: { data: { turbo_confirm: t(".confirm_forget_host_key") } } %>
      <% elsif !@scanned_host_keys %>
        <%= link_to t(".scan_host_key"), server_path(@server, scan: 1), class: "btn btn-sm" %>
      <% end %>
    </div>
    <div class="card-body space-y-2 text-sm">
      <% if @host_keys.any? %>
        <% @host_keys.each do |key| %>
          <p><span class="text-muted"><%= key.type %></span> <code class="break-all"><%= key.fingerprint %></code></p>
        <% end %>
      <% elsif @scanned_host_keys&.any? %>
        <p class="text-muted"><%= t(".compare_html", command: tag.code("ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub")) %></p>
        <% @scanned_host_keys.each do |key| %>
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p><span class="text-muted"><%= key.type %></span> <code class="break-all"><%= key.fingerprint %></code></p>
            <%= button_to t(".trust_host_key"), trust_host_key_server_path(@server), params: { fingerprint: key.fingerprint }, class: "btn btn-sm" %>
          </div>
        <% end %>
      <% elsif @scanned_host_keys %>
        <p class="text-danger"><%= t(".scan_failed") %></p>
      <% else %>
        <p class="text-muted"><%= t(".no_host_key") %></p>
      <% end %>
    </div>
  <% end %>

  <%= render Ui::PanelComponent.new do %>
    <div class="card-header">
      <div>
        <h2 class="card-title"><%= t("layouts.application.projects") %></h2>
        <p class="text-xs text-muted"><%= t(".projects_hint_html") %></p>
      </div>
    </div>
    <% if @projects.empty? %>
      <p class="px-4 py-6 text-center text-sm text-muted"><%= t(".no_projects") %></p>
    <% else %>
      <div class="overflow-x-auto"><table class="table">
        <thead><tr><th><%= t("common.project") %></th><th><%= t("common.destination") %></th><th><%= t("common.cpu") %></th><th><%= t("common.ram") %></th><th><%= t("common.disk") %></th></tr></thead>
        <tbody>
          <% @projects.each do |project| %>
            <% metric = @metrics.find { |sample| sample.project_id == project.id && !sample.error } %>
            <tr>
              <td><%= link_to project.name, project_path(project), class: "font-medium text-foreground hover:underline" %></td>
              <td><%= destination_badges(project, @server.host) %></td>
              <% [ metric&.app_cpu_percent, metric&.app_memory_percent, metric&.app_disk_percent ].each do |percent| %>
                <td class="w-28 text-xs tabular-nums text-muted"><%= percent ? "#{percent.round}%" : "–" %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table></div>
    <% end %>
  <% end %>

  <% if (machine = @metrics.reject(&:error).max_by(&:collected_at)) %>
    <%= render Ui::PanelComponent.new do %>
      <div class="card-header">
        <h2 class="card-title"><%= t(".resources") %></h2>
        <span class="text-xs text-muted"><%= t("common.updated_at", time: time_ago(machine.collected_at)) %></span>
      </div>
      <div class="card-body grid gap-4 sm:grid-cols-3">
        <% [ [ t("common.cpu"), machine.cpu_percent, nil ],
             [ t("common.ram"), machine.memory_percent, machine.memory_total && "#{number_to_human_size(machine.memory_used)} / #{number_to_human_size(machine.memory_total)}" ],
             [ t("common.disk"), machine.disk_percent, machine.disk_total && "#{number_to_human_size(machine.disk_used)} / #{number_to_human_size(machine.disk_total)}" ] ].each do |label, percent, detail| %>
          <div>
            <div class="mb-2 flex items-baseline justify-between text-xs"><span class="text-muted"><%= label %></span><span class="font-medium tabular-nums"><%= percent ? "#{percent.round}%" : "–" %></span></div>
            <%= meter(percent) %>
            <% if detail %><p class="mt-1.5 text-[11px] text-faint"><%= detail %></p><% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if @server.notes.present? %>
    <%= render Ui::PanelComponent.new do %>
      <div class="card-header"><h2 class="card-title"><%= t(".notes") %></h2></div>
      <div class="card-body text-sm whitespace-pre-wrap"><%= @server.notes %></div>
    <% end %>
  <% end %>
</div>
