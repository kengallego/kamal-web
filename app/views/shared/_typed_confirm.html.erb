<dialog data-controller="typed-confirm" aria-labelledby="confirmation-message" class="m-auto w-[min(28rem,calc(100vw-2rem))] rounded-2xl border border-line bg-surface p-0 text-foreground shadow-2xl backdrop:bg-black/35 backdrop:backdrop-blur-sm">
  <form method="dialog" class="space-y-5 p-6">
    <span class="grid size-10 place-items-center rounded-xl bg-warning/10 text-warning"><%= render Ui::IconComponent.new(name: :shield, size: 20) %></span>
    <p id="confirmation-message" class="text-base leading-relaxed font-medium" data-typed-confirm-target="message"></p>
    <div class="space-y-3" data-typed-confirm-target="challenge">
      <p class="text-sm leading-relaxed text-muted"><%= t(".protected_html", word: tag.code("", class: "font-semibold text-foreground", data: { typed_confirm_target: "word" })) %></p>
      <input type="text" class="input font-mono" autocomplete="off" spellcheck="false" aria-label="<%= t(".label") %>"
        data-typed-confirm-target="input" data-action="input->typed-confirm#check">
    </div>
    <div class="flex flex-row-reverse gap-2 border-t border-line pt-5">
      <button value="confirm" class="btn btn-primary" data-typed-confirm-target="confirm" disabled><%= t(".confirm") %></button>
      <button value="cancel" class="btn" formnovalidate><%= t("common.cancel") %></button>
    </div>
  </form>
</dialog>
