<%# locals: (project:, destination: :none) %>
<%= turbo_stream_from project %>

<div class="mb-6">
  <% description = [project.source_description, short_sha(project.git_revision), (t('.synced', time: time_ago(project.synced_at)) if project.synced_at)].compact_blank.join(' · ') %>
  <%= render Ui::PageHeaderComponent.new(title: project.name, description: description) do %>
    <% unless destination == :none || project.destinations.size < 2 %>
      <div class="flex rounded-lg border border-line bg-surface p-1">
        <% project.destinations.each do |name| %>
          <%= link_to destination_label(name), url_for(request.query_parameters.merge(destination: name.to_s)), class: ['rounded-md px-3 py-1.5 text-xs font-medium', name == destination ? 'bg-accent-soft text-accent' : 'text-muted hover:text-foreground'], aria: { current: ('page' if name == destination) } %>
        <% end %>
      </div>
    <% end %>
    <%= button_to sync_project_path(project), class: 'btn', title: t('.sync_title') do %><%= render Ui::IconComponent.new(name: :refresh, size: 15) %><%= t('common.sync') %><% end %>
  <% end %>

  <% if (alerts = project.alerts.active.latest_first.to_a).any? %>
    <div class="mt-4 overflow-hidden rounded-lg border border-danger/30 bg-danger/5">
      <p class="border-b border-danger/15 px-4 py-2 text-sm font-medium text-danger"><%= t("alerts.heading", count: alerts.size) %></p>
      <%= render "alerts/list", alerts: alerts %>
    </div>
  <% end %>

  <% if project.sync_error.present? %>
    <div class="mt-4 rounded-lg border border-danger/30 bg-danger/10 p-3 text-sm text-danger">
      <p class="font-medium"><%= t(".sync_failed") %></p>
      <pre class="mt-1 whitespace-pre-wrap font-mono text-xs"><%= project.sync_error %></pre>
    </div>
  <% end %>

  <% if project.discovered? %>
    <% metrics = project.latest_metrics %>
    <% if (failed = metrics.select(&:error)).any? %>
      <div class="mt-4 rounded-lg border border-warning/30 bg-warning/10 p-3 text-sm text-warning">
        <p class="font-medium"><%= t(".ssh_failed", hosts: failed.map(&:host).to_sentence) %></p>
        <pre class="mt-1 whitespace-pre-wrap font-mono text-xs text-warning/80"><%= failed.first.error.to_s.last(500) %></pre>
        <% if project.ssh_private_key.blank? %>
          <p class="mt-2 text-warning/80"><%= t(".authorize") %></p>
          <pre class="mt-1 overflow-x-auto rounded bg-canvas p-2 font-mono text-xs text-body"><%= Setting::AUTHORIZE_THIS_SERVER %></pre>
          <p class="mt-1 text-xs text-warning/60"><%= t(".checked_every_minute_html", monitoring: link_to(t("common.monitoring"), project_monitoring_path(project), class: "underline")) %></p>
        <% end %>
      </div>
    <% end %>
    <p class="mt-4 text-sm text-muted">
      <%= t(".detected") %><%= t(".checking_ssh") if metrics.empty? && project.monitoring_enabled? %>.
      <%= t(".connect_repository_html", link: link_to(t(".add_repository"), edit_project_path(project), class: "underline hover:text-body")) %>
    </p>
  <% end %>

  <%= render "projects/activity", project: project %>

  <% dest = destination == :none ? {} : { destination: destination.to_s } %>
<nav aria-label="<%= t('ui.project_navigation') %>" class="mt-7 flex gap-1 overflow-x-auto rounded-xl bg-subtle p-1.5">
    <% [
      [ :grid, t("common.overview"), project_path(project, dest) ],
      [ :terminal, t("common.commands"), project_commands_path(project, dest) ],
      [ :code, t("common.console"), project_console_sessions_path(project, dest) ],
      [ :activity, t("common.activity"), project_command_runs_path(project) ],
      [ :server, t("common.monitoring"), project_monitoring_path(project) ],
      [ :globe, t("common.proxy"), project_proxy_path(project, dest) ],
      [ :branch, t("common.config"), project_config_path(project, dest) ],
      [ :settings, t("common.settings"), project_settings_path(project) ]
    ].each do |icon, label, path| %>
      <%= link_to path, class: ["tab", ("tab-active" if request.path == URI(path).path)], aria: { current: ("page" if request.path == URI(path).path) } do %><%= render Ui::IconComponent.new(name: icon, size: 15) %><%= label %><% end %>
    <% end %>
  </nav>
</div>
