<%= link_to project_path(@project), class: 'card project-card group', data: { filter_target: 'item', filter_text: [@project.name, @project.source_description, *@project.hosts].join(' ') } do %>
  <div class="flex items-start justify-between gap-3 p-6">
    <div class="flex min-w-0 items-center gap-3.5">
      <span class="project-avatar" aria-hidden="true"><%= @project.name.first(2).upcase %></span>
      <div class="min-w-0">
        <h3 class="truncate text-[15px] font-semibold text-foreground"><%= @project.name %></h3>
        <p class="mt-1 truncate text-xs text-muted" title="<%= @project.source_description %>"><%= @project.git? ? @project.repository_url.to_s.sub(%r{\Ahttps?://}, '').delete_suffix('.git') : @project.source_description %></p>
      </div>
    </div>
    <span class="mt-1 text-faint transition-transform group-hover:translate-x-1 group-hover:text-accent"><%= render Ui::IconComponent.new(name: :arrow, size: 17) %></span>
  </div>
  <% if @project.sync_error.present? %>
    <div class="px-6 pb-4"><%= render Ui::BadgeComponent.new(label: t('dashboard.show.sync_error'), tone: :danger, dot: true) %></div>
  <% elsif (operation = @project.active_operation) %>
    <div class="px-6 pb-4"><%= render Ui::BadgeComponent.new(label: t('dashboard.show.operation_running', operation: operation.command.label.downcase), tone: :info, dot: true) %></div>
  <% end %>
  <div class="mt-auto space-y-4 border-t border-line/70 px-6 py-5">
    <% @project.destinations.each do |destination| %>
      <% deploy = @project.last_deploy(destination) %>
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
        <span class="flex items-center gap-2 text-muted"><%= render Ui::IconComponent.new(name: :globe, size: 13) %><%= helpers.destination_label(destination) %></span>
        <span class="flex min-w-0 items-center gap-2">
          <% if deploy %>
            <%= helpers.status_badge(deploy.status) %>
          <% elsif (release = live_release(destination)) %>
            <span class="truncate font-mono text-faint" title="<%= release.version %>"><%= release.version.truncate(24) %></span>
            <%= render Ui::BadgeComponent.new(label: t('projects.releases.releases.live'), tone: :success, dot: true) %>
          <% else %>
            <span class="text-faint"><%= t('common.never_deployed') %></span>
          <% end %>
        </span>
      </div>
    <% end %>
  </div>
  <% if @metrics.present? %>
    <div class="grid grid-cols-3 gap-5 border-t border-line/70 px-6 py-4">
    <% {t('common.cpu') => :cpu, t('common.ram') => :memory, t('common.disk') => :disk}.each do |label, resource| %>
      <% value, total = resource_usage(resource) %>
      <div title="<%= t('ui.resource_usage', app: value ? "#{value.round}%" : '–', total: total ? "#{total.round}%" : '–') %>">
        <div class="mb-2 flex items-start justify-between text-[10px] text-muted">
          <span><%= label %></span>
          <span class="flex flex-col items-end tabular-nums"><span class="font-medium text-success"><%= value ? "#{value.round}%" : '–' %></span><span class="mt-0.5 text-[9px] text-success/50"><%= total ? "#{total.round}%" : '–' %></span></span>
        </div>
        <%= render Ui::MeterComponent.new(percent: value, total_percent: total) %>
      </div>
      <% end %>
    </div>
  <% end %>
  <div class="flex flex-wrap items-center justify-between gap-2 border-t border-line/70 px-6 py-3 text-[11px] text-faint">
    <span class="flex items-center gap-1.5"><%= render Ui::IconComponent.new(name: :branch, size: 12) %><%= @project.branch %></span>
    <% if (deployed_at = last_deployed_at) %><span><%= helpers.time_ago(deployed_at) %></span><% elsif live_releases.none? %><span><%= t('ui.awaiting_deploy') %></span><% end %>
  </div>
<% end %>
