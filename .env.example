# Copy to .env next to compose.yml and adjust. Everything is optional.
KAMAL_UI_PORT=3000
ADMIN_EMAIL=you@example.com
# Leave empty to generate a password, printed once in `docker compose logs`.
ADMIN_PASSWORD=
KAMAL_UI_URL=https://kamal-ui.example.com
ASSUME_SSL=false
FORCE_SSL=false
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAILER_FROM=Kamal UI <kamal-ui@example.com>
# Only if Kamal UI can't SSH into its own server through the container gateway.
KAMAL_UI_HOST_ADDRESS=
