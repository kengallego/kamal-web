<%= turbo_frame_tag "releases" do %>
  <% if @error %>
    <p class="px-4 py-4 text-sm text-danger"><%= @error %></p>
  <% elsif @releases.empty? %>
    <p class="px-4 py-4 text-sm text-muted"><%= t(".empty") %></p>
  <% else %>
    <% can_roll_back = @project.allows_command?(CommandCatalog.find("rollback")) %>
    <ul class="divide-y divide-line">
      <% @releases.each do |release| %>
        <li class="flex items-center justify-between gap-3 px-4 py-2 text-sm">
          <div class="min-w-0">
            <span class="font-mono text-body" title="<%= release.version %>"><%= release.version.match?(/\A\h{40}\z/) ? short_sha(release.version) : release.version.truncate(24) %></span>
            <% if release.current %>
              <span class="badge badge-success ml-1"><%= t(".live") %></span>
            <% elsif release.running? %>
              <span class="badge badge-warning ml-1"><%= t("statuses.running") %></span>
            <% end %>
            <% if release.created_at %>
              <span class="ml-1 text-xs text-muted"><%= t(".deployed", time: time_ago(release.created_at)) %></span>
            <% end %>
          </div>
          <% if !release.current && can_roll_back %>
            <%= button_to t(".roll_back"), project_command_runs_path(@project), params: { kind: "rollback", destination: @destination, options: { version: release.version } },
              class: "btn btn-sm", form: { data: { turbo_frame: "_top", **command_confirm(@project, @destination, t(".confirm", project: @project.name, version: release.version.first(12))) } } %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if !can_roll_back && @releases.size > 1 %>
      <p class="border-t border-line px-4 py-3 text-xs text-muted"><%= t(".needs_repository") %></p>
    <% end %>
  <% end %>
<% end %>
