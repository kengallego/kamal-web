<% content_for :title, "Sign in" %>

<div class="card card-body">
  <h1 class="mb-6 text-lg font-semibold text-zinc-100">Sign in</h1>

  <% if (problem = AccessPassword.problem) %>
    <p class="rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-sm text-red-300"><%= problem %></p>
  <% else %>
    <%= form_with url: session_url, class: "space-y-4" do |form| %>
      <%# Lets password managers tell this instance apart from others. %>
      <%= hidden_field_tag :username, "kamal-web@#{request.host}", autocomplete: "username", id: nil %>
      <div>
        <%= form.label :password, class: "label" %>
        <%= form.password_field :password, required: true, autofocus: true, autocomplete: "current-password", class: "input" %>
      </div>

      <%= form.submit "Sign in", class: "btn btn-primary w-full" %>
    <% end %>

    <p class="mt-4 text-center text-xs text-zinc-500">The password is <code class="text-zinc-400">KAMAL_WEB_PASSWORD</code> from the <code class="text-zinc-400">.env</code> file Kamal Web was deployed with.</p>
  <% end %>
</div>
