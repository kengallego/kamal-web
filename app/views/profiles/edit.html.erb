<% content_for :title, "Profile" %>
<h1 class="mb-6 text-xl font-semibold text-zinc-100">Profile</h1>

<%= form_with model: current_user, url: profile_path, method: :patch, class: "card card-body max-w-xl space-y-4" do |form| %>
  <%= form_errors(current_user) %>
  <div>
    <%= form.label :name, class: "label" %>
    <%= form.text_field :name, class: "input" %>
  </div>
  <div>
    <%= form.label :email_address, "Email", class: "label" %>
    <%= form.email_field :email_address, required: true, class: "input" %>
  </div>

  <div class="border-t border-zinc-800 pt-4">
    <p class="mb-3 text-sm font-medium text-zinc-300">Change password</p>
    <div class="space-y-4">
      <div>
        <%= form.label :password_challenge, "Current password", class: "label" %>
        <%= form.password_field :password_challenge, autocomplete: "current-password", class: "input" %>
      </div>
      <div>
        <%= form.label :password, "New password", class: "label" %>
        <%= form.password_field :password, minlength: 10, maxlength: 72, autocomplete: "new-password", class: "input" %>
      </div>
      <div>
        <%= form.label :password_confirmation, "Confirm new password", class: "label" %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "input" %>
      </div>
    </div>
  </div>

  <%= form.submit "Save", class: "btn btn-primary" %>
<% end %>
