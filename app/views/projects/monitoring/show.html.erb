<% content_for :title, "Monitoring · #{@project.name}" %>
<%= render "projects/header", project: @project %>

<div class="mb-4 flex items-center justify-between gap-4">
  <p class="text-sm text-zinc-500">
    <% if @project.monitoring_enabled? %>
      Sampled every minute over SSH, kept for 24 hours.
    <% else %>
      Background monitoring is off for this project. Turn it on in the project settings.
    <% end %>
  </p>
  <%= button_to "Refresh now", project_monitoring_path(@project), class: "btn" %>
</div>

<% if @hosts.empty? %>
  <div class="card card-body text-center text-sm text-zinc-500">No hosts found in the Kamal config.</div>
<% end %>

<div class="space-y-6">
  <% @hosts.each do |host| %>
    <% samples = @history[host] || [] %>
    <% latest = samples.last %>
    <div class="card">
      <div class="card-header">
        <h2 class="card-title font-mono"><%= host %></h2>
        <span class="text-xs text-zinc-500">
          <% if latest %>updated <%= time_ago_in_words(latest.collected_at) %> ago<% else %>no samples yet<% end %>
        </span>
      </div>

      <% if latest&.error %>
        <div class="card-body text-sm text-red-300"><%= latest.error %></div>
      <% elsif latest %>
        <div class="card-body grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <% [
            [ "CPU", latest.cpu_percent, "#{latest.cpu_percent&.round || "–"}%", samples.map(&:cpu_percent) ],
            [ "Load", latest.load_percent, "#{latest.load_1} / #{latest.cpu_count} cores", samples.map(&:load_percent) ],
            [ "Memory", latest.memory_percent, "#{number_to_human_size(latest.memory_used)} / #{number_to_human_size(latest.memory_total)}", samples.map(&:memory_percent) ],
            [ "Disk", latest.disk_percent, "#{number_to_human_size(latest.disk_used)} / #{number_to_human_size(latest.disk_total)}", samples.map(&:disk_percent) ]
          ].each do |label, percent, detail, history| %>
            <div class="rounded-lg border border-zinc-800 p-3">
              <div class="flex items-baseline justify-between">
                <span class="label mb-0"><%= label %></span>
                <span class="text-lg font-semibold text-zinc-100"><%= percent ? "#{percent.round}%" : "–" %></span>
              </div>
              <p class="mb-2 text-xs text-zinc-500"><%= detail %></p>
              <%= meter(percent) %>
              <div class="mt-3 flex h-10 items-end gap-px" title="Last 24 hours">
                <% history.last(60).each do |value| %>
                  <% value = value.to_f.clamp(0, 100) %>
                  <span class="flex-1 rounded-sm <%= value >= 90 ? "bg-red-400/70" : value >= 70 ? "bg-amber-400/70" : "bg-emerald-400/50" %>" style="height: <%= [ value, 3 ].max %>%"></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <% if latest.containers.any? %>
          <div class="overflow-x-auto border-t border-zinc-800">
            <table class="table">
              <thead><tr><th>Container</th><th>Image</th><th>Status</th><th>Ports</th><th></th></tr></thead>
              <tbody>
                <% latest.containers.each do |container| %>
                  <tr>
                    <td class="flex items-center gap-2 font-mono text-xs text-zinc-200">
                      <span class="size-2 shrink-0 rounded-full <%= container["State"] == "running" ? "bg-emerald-400" : "bg-zinc-600" %>"></span>
                      <%= container["Names"] %>
                    </td>
                    <td class="font-mono text-xs text-zinc-500"><%= container["Image"].to_s.truncate(60) %></td>
                    <td class="text-xs text-zinc-400"><%= container["Status"] %></td>
                    <td class="font-mono text-xs text-zinc-500"><%= container["Ports"] %></td>
                    <td class="text-right">
                      <%= button_to "Logs", project_command_runs_path(@project), class: "btn btn-sm",
                        params: { kind: "app_logs", destination: @project.destination_for_host(host),
                          "options[host]" => host, "options[container_id]" => container["Names"], "options[lines]" => 200, "options[follow]" => "1" } %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
