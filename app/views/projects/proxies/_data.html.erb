<%= turbo_frame_tag "proxy_data" do %>
  <div class="card mb-6">
    <div class="card-header"><h2 class="card-title">Routes</h2></div>
    <% if @routes.empty? %>
      <p class="px-4 py-6 text-center text-sm text-zinc-500">kamal-proxy reported no routes. Is it running on <%= @host %>?</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="table">
          <thead><tr><th>Service</th><th>Host</th><th>Path</th><th>Target</th><th>State</th><th>TLS</th></tr></thead>
          <tbody>
            <% @routes.each do |route| %>
              <tr>
                <td class="text-zinc-100"><%= route.service %></td>
                <td class="text-zinc-300"><%= route.host %></td>
                <td class="font-mono text-xs text-zinc-400"><%= route.path %></td>
                <td class="font-mono text-xs text-zinc-400"><%= route.target %></td>
                <td><span class="badge <%= route.state.casecmp?("running") ? "badge-success" : "badge-warning" %>"><%= route.state %></span></td>
                <td><span class="badge <%= route.tls.casecmp?("yes") ? "badge-success" : "badge-neutral" %>"><%= route.tls %></span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <% total = @requests.size %>
  <div class="mb-6 grid gap-3 sm:grid-cols-4">
    <% [
      [ "Requests", total ],
      [ "Errors (5xx)", @requests.count { |r| r.status >= 500 } ],
      [ "Median", @requests.any? ? "#{@requests.map(&:duration_ms).sort[total / 2]} ms" : "–" ],
      [ "p95", @requests.any? ? "#{@requests.map(&:duration_ms).sort[(total * 0.95).floor.clamp(0, total - 1)]} ms" : "–" ]
    ].each do |label, value| %>
      <div class="card p-4">
        <p class="label"><%= label %></p>
        <p class="text-xl font-semibold text-zinc-100"><%= value %></p>
      </div>
    <% end %>
  </div>

  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Recent requests</h2>
      <span class="text-xs text-zinc-500">last 300 log lines</span>
    </div>
    <% if @requests.empty? %>
      <p class="px-4 py-6 text-center text-sm text-zinc-500">No requests in the recent proxy log.</p>
    <% else %>
      <div class="max-h-[60vh] overflow-auto">
        <table class="table">
          <thead class="sticky top-0 bg-zinc-900"><tr><th>Time</th><th>Status</th><th>Method</th><th>Host</th><th>Path</th><th>Duration</th><th>Service</th></tr></thead>
          <tbody>
            <% @requests.each do |request| %>
              <tr>
                <td class="whitespace-nowrap text-xs text-zinc-500"><%= request.time&.strftime("%H:%M:%S") %></td>
                <td><span class="badge <%= request.status >= 500 ? "badge-danger" : request.status >= 400 ? "badge-warning" : request.status >= 300 ? "badge-info" : "badge-success" %>"><%= request.status %></span></td>
                <td class="text-xs text-zinc-400"><%= request.method %></td>
                <td class="text-xs text-zinc-300"><%= request.host %></td>
                <td class="max-w-md truncate font-mono text-xs text-zinc-300" title="<%= request.path %>"><%= request.path %></td>
                <td class="whitespace-nowrap text-xs text-zinc-400"><%= request.duration_ms %> ms</td>
                <td class="text-xs text-zinc-500"><%= request.service %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
<% end %>
