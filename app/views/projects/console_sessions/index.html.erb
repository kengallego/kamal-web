<% content_for :title, "#{t("common.console")} · #{@project.name}" %>
<%= render "projects/header", project: @project, destination: @destination %>

<div class="grid gap-6 lg:grid-cols-3">
  <%= render Ui::PanelComponent.new(class: 'min-w-0 lg:col-span-1') do %>
    <div class="card-header"><h2 class="card-title"><%= t(".open_title") %></h2></div>
    <%= form_with url: project_console_sessions_path(@project), class: "card-body space-y-4" do |form| %>
        <%= hidden_field_tag :destination, @destination, id: nil %>
        <div>
          <label class="label" for="console_kind"><%= t("common.console") %></label>
          <%= select_tag :kind, options_for_select(ConsoleSession::KINDS.map { |key, kind| [ kind[:label], key ] }), class: "input", id: "console_kind" %>
        </div>
        <div>
          <label class="label" for="console_host"><%= t("common.host") %></label>
          <%= select_tag :host, options_for_select(@config.all_hosts), include_blank: @config.primary_host ? t(".primary_host_named", host: @config.primary_host) : t(".primary_host"), class: "input", id: "console_host" %>
        </div>
        <p class="hint">
          <%= t(".hint_html", command: tag.span("kamal app exec --interactive --reuse", class: "font-mono"), destination: tag.span(destination_label(@destination), class: "text-body"), idle: distance_of_time_in_words(ConsoleProcess::IDLE_TIMEOUT)) %>
        </p>
        <%= form.submit t(".open"), class: "btn btn-primary" %>
    <% end %>
  <% end %>

  <%= render Ui::PanelComponent.new(class: 'min-w-0 lg:col-span-2') do %>
    <div class="card-header"><h2 class="card-title"><%= t(".recent") %></h2></div>
    <% if @sessions.any? %>
      <div class="overflow-x-auto">
        <table class="table">
          <thead><tr><th><%= t("common.console") %></th><th><%= t("common.destination") %></th><th><%= t("common.host") %></th><th><%= t("common.when") %></th><th><%= t("common.duration") %></th></tr></thead>
          <tbody>
            <% @sessions.each do |session| %>
              <tr>
                <td class="text-body">
                  <%= session.label %>
                  <% if session.active? %><span class="badge badge-success ml-1"><%= t(".open_badge") %></span><% end %>
                </td>
                <td class="text-muted"><%= destination_label(session.destination) %></td>
                <td class="font-mono text-xs text-muted"><%= session.host || t(".primary") %></td>
                <td class="text-muted"><%= time_ago(session.created_at) %></td>
                <td class="text-muted"><%= session.duration ? distance_of_time_in_words(session.duration) : t(".never_opened") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="card-body text-sm text-muted"><%= t(".empty") %></p>
    <% end %>
  <% end %>
</div>
