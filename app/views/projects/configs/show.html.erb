<% content_for :title, "Config · #{@project.name}" %>
<%= render "projects/header", project: @project, destination: @destination %>

<p class="mb-4 text-sm text-zinc-500">
  Merged configuration for <span class="text-zinc-300"><%= destination_label(@destination) %></span>
  from <code><%= @project.config_file %></code><%= " and its #{@destination} override" if @destination %>, with ERB rendered. Secret values are not shown.
</p>

<% if @config.error %>
  <div class="card card-body"><pre class="whitespace-pre-wrap font-mono text-xs text-red-300"><%= @config.error %></pre></div>
<% elsif @config.raw_config %>
  <pre class="terminal"><%= @config.raw_config.to_yaml.delete_prefix("---\n") %></pre>
<% else %>
  <div class="card card-body text-sm text-zinc-500">Config not loaded yet. Press Sync.</div>
<% end %>
