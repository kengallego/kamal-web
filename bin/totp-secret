#!/usr/bin/env ruby
# Generates a secret for KAMAL_WEB_TOTP_SECRET. Needs only Ruby, which Kamal
# already requires, so it runs on the machine you deploy from:
#   bin/totp-secret
require "securerandom"

alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
secret = Array.new(32) { alphabet[SecureRandom.random_number(32)] }.join

puts <<~TEXT
  Add this line to .env and run `kamal deploy`:

    KAMAL_WEB_TOTP_SECRET=#{secret}

  In your authenticator app, add an account by entering the key by hand:

    #{secret.scan(/.{4}/).join(" ")}

  Or open this link on the phone with the app:

    otpauth://totp/Kamal%20Web?secret=#{secret}&issuer=Kamal%20Web
TEXT
