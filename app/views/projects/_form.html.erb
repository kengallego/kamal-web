<%= form_with model: project, class: "space-y-6", data: { controller: "source-kind" } do |form| %>
  <%= form_errors(project) %>

  <%= render Ui::PanelComponent.new do %>
    <div class="card-header"><h2 class="card-title"><%= t(".source") %></h2></div>
    <div class="card-body space-y-4">
      <div>
        <%= form.label :name, t(".name"), class: "label" %>
        <%= form.text_field :name, required: true, class: "input", placeholder: "my-app" %>
      </div>

      <div>
        <span class="label"><%= t(".where") %></span>
        <div class="flex flex-wrap gap-3 text-sm">
          <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-line px-4 py-3 has-[:checked]:border-accent has-[:checked]:bg-accent-soft has-[:checked]:text-accent"><%= form.radio_button :source_kind, "git", data: { action: "source-kind#toggle" } %> <%= t(".kind_git") %></label>
          <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-line px-4 py-3 has-[:checked]:border-accent has-[:checked]:bg-accent-soft has-[:checked]:text-accent"><%= form.radio_button :source_kind, "local", data: { action: "source-kind#toggle" } %> <%= t(".kind_local") %></label>
          <% if project.discovered? || project.discovered_service.present? %>
            <label class="flex items-center gap-2"><%= form.radio_button :source_kind, "discovered", data: { action: "source-kind#toggle" } %> <%= t(".kind_discovered") %></label>
          <% end %>
        </div>
      </div>

      <div data-source-kind-target="git" class="space-y-4">
        <div>
          <%= form.label :repository_url, t(".repository_url"), class: "label" %>
          <%= form.text_field :repository_url, class: "input font-mono", placeholder: t(".repository_url_placeholder") %>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :branch, t(".branch"), class: "label" %>
            <%= form.text_field :branch, class: "input font-mono" %>
          </div>
          <div>
            <%= form.label :git_access_token, t(".token"), class: "label" %>
            <%= form.password_field :git_access_token, value: nil, class: "input", autocomplete: "off", placeholder: project.git_access_token.present? ? t(".token_stored") : t(".token_placeholder") %>
          </div>
        </div>
        <div>
          <%= form.label :git_ssh_private_key, t(".deploy_key"), class: "label" %>
          <%= form.text_area :git_ssh_private_key, value: nil, rows: 3, class: "input font-mono text-xs", autocomplete: "off",
            placeholder: project.git_ssh_private_key.present? ? t(".key_stored") : t(".deploy_key_placeholder") %>
        </div>
      </div>

      <div data-source-kind-target="local">
        <%= form.label :local_path, t(".folder"), class: "label" %>
        <%= form.text_field :local_path, class: "input font-mono", placeholder: "#{Rails.configuration.x.projects_path}/my-app" %>
        <p class="hint"><%= t(".folder_hint_html", path: tag.code(Rails.configuration.x.projects_path)) %></p>
      </div>

      <div>
        <%= form.label :config_file, t(".config_file"), class: "label" %>
        <%= form.text_field :config_file, class: "input font-mono" %>
        <p class="hint"><%= t(".config_file_hint_html") %></p>
      </div>
    </div>
  <% end %>

  <%= render Ui::PanelComponent.new do %>
    <div class="card-header"><h2 class="card-title"><%= t(".server_access") %></h2></div>
    <div class="card-body space-y-4">
      <div>
        <%= form.label :ssh_private_key, t(".ssh_key"), class: "label" %>
        <%= form.text_area :ssh_private_key, value: nil, rows: 5, class: "input font-mono text-xs", autocomplete: "off",
          placeholder: project.ssh_private_key.present? ? t(".key_stored") : t(".ssh_key_placeholder") %>
        <p class="hint"><%= t(".ssh_key_hint") %></p>
      </div>
      <label class="flex items-center gap-2 text-sm">
        <%= form.check_box :monitoring_enabled %> <%= t(".monitoring") %>
      </label>
      <% if project.persisted? %>
        <div>
          <span class="label"><%= t(".protected_destinations") %></span>
          <div class="flex flex-wrap gap-4 text-sm">
            <%= hidden_field_tag "project[protected_destinations][]", "", id: nil %>
            <% project.destinations.each do |destination| %>
              <label class="flex items-center gap-2">
                <%= check_box_tag "project[protected_destinations][]", destination || ".", project.protected_destination?(destination), id: nil %>
                <%= destination_label(destination) %>
              </label>
            <% end %>
          </div>
          <p class="hint"><%= t(".protected_destinations_hint") %></p>
        </div>
      <% end %>
    </div>
  <% end %>

  <details class="disclosure" <%= 'open' if project.notification_webhook_url.present? || project.errors[:notification_webhook_url].any? %>>
    <summary><%= t(".notifications") %><span class="ml-auto text-xs font-normal text-muted"><%= t('ui.optional') %></span></summary>
    <div class="card-body grid gap-4 sm:grid-cols-3">
      <div class="sm:col-span-2">
        <%= form.label :notification_webhook_url, t(".webhook_url"), class: "label" %>
        <%= form.text_field :notification_webhook_url, class: "input", placeholder: "https://hooks.slack.com/services/…" %>
        <p class="hint"><%= t(".webhook_hint") %></p>
      </div>
      <div>
        <%= form.label :notification_format, t(".format"), class: "label" %>
        <%= form.select :notification_format, Project::NOTIFICATION_FORMATS.map { |f| [ t(".formats.#{f}", default: f.capitalize), f ] }, {}, class: "input" %>
      </div>
    </div>
  </details>

  <div class="form-footer">
    <%= form.submit project.new_record? ? t(".create") : t(".save"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), project.new_record? ? root_path : project_settings_path(project), class: "btn" %>
  </div>
<% end %>
