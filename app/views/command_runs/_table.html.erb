<% if runs.empty? %>
  <p class="px-4 py-6 text-center text-sm text-zinc-500">No commands have run yet.</p>
<% else %>
  <div class="overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th>Command</th>
          <% if local_assigns[:show_project] %><th>Project</th><% end %>
          <th>Destination</th>
          <th>Status</th>
          <th>Revision</th>
          <th>By</th>
          <th>When</th>
          <th>Duration</th>
        </tr>
      </thead>
      <tbody>
        <% runs.each do |run| %>
          <tr class="hover:bg-zinc-900">
            <td><%= link_to run.command.label, project_command_run_path(run.project, run), class: "font-medium text-zinc-100 hover:text-emerald-300" %></td>
            <% if local_assigns[:show_project] %><td class="text-zinc-400"><%= run.project.name %></td><% end %>
            <td class="text-zinc-400"><%= destination_label(run.destination) %></td>
            <td><%= render "command_runs/status", run: run %></td>
            <td class="font-mono text-xs text-zinc-500"><%= short_sha(run.git_revision) || "–" %></td>
            <td class="text-zinc-400"><%= run.triggered_by %></td>
            <td class="whitespace-nowrap text-zinc-500" title="<%= run.created_at %>"><%= time_ago_in_words(run.created_at) %> ago</td>
            <td class="text-zinc-500"><%= duration_in_words(run.duration) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
