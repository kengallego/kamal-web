<% content_for :title, t("common.settings") %>
<%= render Ui::PageHeaderComponent.new(title: t("common.settings")) %>

<div class="settings-layout max-w-5xl">
  <nav class="settings-nav" aria-label="<%= t('ui.on_this_page') %>">
    <p class="section-label mb-4 px-3"><%= t('ui.on_this_page') %></p>
    <% [['appearance', t('ui.appearance')], ['status-board', t('.status_board')], ['alerts', t('.alerts')], ['access', t('.access_key')], ['backups', t('.backup')], ['version', t('.instance')]].each do |id, label| %>
      <%= link_to label, "##{id}", class: 'nav-link' %>
    <% end %>
  </nav>
  <div class="min-w-0 space-y-6">
  <%= form_errors(@setting) %>
  <%= render Ui::PanelComponent.new(title: t('ui.appearance'), id: 'appearance') do %>
    <div class="card-body space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span class="text-sm text-body"><%= t('shared.preferences.language') %></span>
        <%= render Ui::LanguageSwitcherComponent.new %>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line pt-5">
        <span class="text-sm text-body"><%= t('shared.preferences.theme') %></span>
        <div class="flex flex-wrap gap-1 rounded-xl border border-line p-1" role="group" aria-label="<%= t('shared.preferences.theme') %>">
          <% Preferences::THEMES.each do |theme| %>
            <%= button_to t("shared.preferences.themes.#{theme}"), preferences_path, method: :patch, params: { theme: theme }, form: { data: { turbo: false } }, class: ['rounded-lg px-3 py-2 text-xs font-medium', current_theme == theme ? 'bg-accent-soft text-accent' : 'text-muted hover:bg-subtle'], 'aria-pressed': current_theme == theme %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
  <%= render Ui::PanelComponent.new(id: "status-board") do %>
    <div class="card-header">
      <div>
        <h2 class="card-title"><%= t(".status_board") %></h2>
        <p class="text-xs text-muted"><%= t(".status_board_hint") %></p>
      </div>
    </div>
    <div class="card-body space-y-4">
      <%= form_with model: @setting, url: settings_path, method: :patch, class: "flex flex-wrap items-center gap-3" do |form| %>
        <label class="flex items-center gap-2 text-sm"><%= form.check_box :status_board_enabled %> <%= t(".enabled") %></label>
        <%= form.submit t("common.save"), class: "btn btn-sm" %>
      <% end %>

      <% if @setting.status_board_enabled? %>
        <% url = status_board_url(@setting.status_board_token) %>
        <div class="flex flex-wrap gap-2 [&>input]:min-w-0 [&>input]:flex-1 [&>input]:basis-48">
          <input type="text" readonly value="<%= url %>" class="input font-mono text-xs">
          <button class="btn" data-controller="clipboard" data-clipboard-error-value="<%= t('ui.copy_failed') %>" data-clipboard-copied-value="<%= t("common.copied") %>" data-clipboard-text-value="<%= url %>" data-action="clipboard#copy"><%= t("common.copy") %></button>
          <%= link_to t(".open"), url, target: "_blank", class: "btn" %>
        </div>
        <%= button_to t(".regenerate"), regenerate_status_board_token_settings_path, class: "btn btn-sm", form: { data: { turbo_confirm: t(".confirm_regenerate") } } %>
      <% end %>
    </div>
  <% end %>

  <%= render Ui::PanelComponent.new(id: "alerts") do %>
    <div class="card-header">
      <div>
        <h2 class="card-title"><%= t(".alerts") %></h2>
        <p class="text-xs text-muted"><%= t(".alerts_hint") %></p>
      </div>
    </div>
    <div class="card-body space-y-4 text-sm">
      <%= form_with model: @setting, url: settings_path, method: :patch, class: "flex flex-wrap items-end gap-4" do |form| %>
        <div>
          <%= form.label :alert_disk_percent, t(".alert_disk"), class: "label" %>
          <div class="flex items-center gap-2"><%= form.number_field :alert_disk_percent, in: 50..100, class: "input w-24" %> %</div>
        </div>
        <div>
          <%= form.label :alert_memory_percent, t(".alert_memory"), class: "label" %>
          <div class="flex items-center gap-2"><%= form.number_field :alert_memory_percent, in: 50..100, class: "input w-24" %> %</div>
        </div>
        <%= form.submit t("common.save"), class: "btn" %>
      <% end %>
      <p class="text-xs text-muted"><%= t(".alerts_list") %></p>
    </div>
  <% end %>

  <%= render Ui::PanelComponent.new(id: "access") do %>
    <div class="card-header">
      <div>
        <h2 class="card-title"><%= t(".access_key") %></h2>
        <p class="text-xs text-muted"><%= t(".access_key_hint") %></p>
      </div>
    </div>
    <div class="card-body space-y-3 text-sm">
      <% [
        [ t(".this_server"), Setting::AUTHORIZE_THIS_SERVER ],
        [ t(".other_servers_html"), @setting.authorize_command ]
      ].each do |intro, command| %>
        <p class="text-muted"><%= intro %></p>
        <div class="flex flex-wrap gap-2 [&>input]:min-w-0 [&>input]:flex-1 [&>input]:basis-48">
          <input type="text" readonly value="<%= command %>" class="input font-mono text-xs">
          <button class="btn" data-controller="clipboard" data-clipboard-error-value="<%= t('ui.copy_failed') %>" data-clipboard-copied-value="<%= t("common.copied") %>" data-clipboard-text-value="<%= command %>" data-action="clipboard#copy"><%= t("common.copy") %></button>
        </div>
      <% end %>
      <% if @setting.ignored_services.any? %>
        <div class="flex items-center justify-between gap-3 border-t border-line pt-3">
          <p class="text-muted"><%= t(".ignored_html", services: tag.span(@setting.ignored_services.to_sentence, class: "font-mono text-body")) %></p>
          <%= button_to t(".detect_again"), reset_ignored_services_settings_path, class: "btn btn-sm" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= render Ui::PanelComponent.new(id: "backups") do %>
    <div class="card-header">
      <div>
        <h2 class="card-title"><%= t(".backup") %></h2>
        <p class="text-xs text-muted"><%= t(".backup_hint") %></p>
      </div>
    </div>
    <div class="card-body space-y-4 text-sm">
      <%= link_to t(".download"), backup_path, class: "btn", data: { turbo: false } %>
      <div class="space-y-3 border-t border-line pt-4">
        <%= form_with model: @setting, url: settings_path, method: :patch, class: "flex flex-wrap items-center gap-3" do |form| %>
          <label class="flex items-center gap-2"><%= form.check_box :scheduled_backups_enabled %> <%= t(".scheduled_backups") %></label>
          <label class="flex items-center gap-2 text-muted"><%= t(".keep") %> <%= form.number_field :scheduled_backups_keep, in: 1..90, class: "input w-20 py-1.5" %></label>
          <%= form.submit t("common.save"), class: "btn btn-sm" %>
        <% end %>
        <p class="text-xs text-muted"><%= t(".scheduled_backups_hint_html", path: tag.code(InstanceBackup::DIRECTORY.relative_path_from(Rails.root))) %></p>
        <% if (stored = InstanceBackup.stored).any? %>
          <ul class="divide-y divide-line rounded-lg border border-line">
            <% stored.each do |path| %>
              <li class="flex items-center justify-between gap-3 px-3 py-2">
                <span class="truncate font-mono text-xs text-body"><%= path.basename %></span>
                <span class="flex shrink-0 items-center gap-3">
                  <span class="text-xs text-muted"><%= number_to_human_size(path.size) %></span>
                  <%= link_to t(".download_short"), stored_backup_path(name: path.basename.to_s), class: "btn btn-sm", data: { turbo: false } %>
                </span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
      <%= form_with url: backup_path, multipart: true, class: "flex flex-wrap items-center gap-2 border-t border-line pt-4",
        data: { turbo_confirm: t(".confirm_restore") } do |form| %>
        <%= form.file_field :backup, accept: ".gz,application/gzip", required: true, class: "text-xs text-muted file:mr-3 file:cursor-pointer file:rounded-lg file:border-0 file:bg-subtle file:px-3 file:py-1.5 file:text-sm file:text-foreground hover:file:bg-hover" %>
        <%= form.submit t(".restore"), class: "btn btn-danger" %>
      <% end %>
      <p class="text-xs text-muted"><%= t(".restore_hint_html") %></p>
    </div>
  <% end %>

  <div id="version" class="card card-body text-sm text-muted space-y-1">
    <p class="font-medium text-body"><%= t(".instance") %></p>
    <% if @setting.update_available? %>
      <p class="text-success">
        <%= t("layouts.application.update_available", version: @setting.latest_version) %><%= link_to t(".release_notes"), @setting.latest_version_url, target: "_blank", rel: "noopener", class: "underline" if @setting.latest_version_url&.start_with?("https://github.com/") %>.
        <%= t(".update_how_html") unless @setting.auto_update_running? %>
      </p>
      <% if @self_update_problem.nil? && !@setting.auto_update_running? %>
        <%= button_to t(".update_now", version: @setting.latest_version), update_instance_settings_path, class: "btn btn-sm", form: { data: { turbo_confirm: t(".confirm_update_now") } } %>
      <% end %>
    <% elsif !CheckForUpdatesJob.enabled? %>
      <p><%= t(".update_check_off_html") %></p>
    <% elsif @setting.update_checked_at %>
      <p><%= t(".up_to_date", time: time_ago(@setting.update_checked_at)) %></p>
    <% end %>
    <% if @setting.auto_update_status %>
      <% if @setting.auto_update_running? %>
        <p><%= t(".auto_update_running", version: @setting.auto_update_version, time: time_ago(@setting.auto_update_started_at)) %></p>
      <% elsif @setting.auto_update_status == "succeeded" %>
        <p><%= t(".auto_update_succeeded", version: @setting.auto_update_version, time: time_ago(@setting.auto_update_finished_at)) %></p>
      <% elsif @setting.auto_update_status == "unsigned" %>
        <p class="text-warning"><%= t(".auto_update_unsigned", version: @setting.auto_update_version, time: time_ago(@setting.auto_update_finished_at || @setting.auto_update_started_at)) %></p>
      <% else %>
        <p class="text-danger"><%= t(".auto_update_failed", version: @setting.auto_update_version, time: time_ago(@setting.auto_update_finished_at || @setting.auto_update_started_at)) %></p>
      <% end %>
      <% if @setting.auto_update_output.present? %>
        <details>
          <summary class="cursor-pointer"><%= t(".auto_update_output") %></summary>
          <pre class="mt-2 max-h-80 overflow-auto rounded-lg bg-subtle p-3 font-mono text-xs"><%= @setting.auto_update_output %></pre>
        </details>
      <% end %>
    <% end %>
    <% if CheckForUpdatesJob.enabled? %>
      <%= form_with model: @setting, url: settings_path, method: :patch, class: "flex flex-wrap items-center gap-3 border-t border-line pt-3" do |form| %>
        <label class="flex items-center gap-2 text-body"><%= form.check_box :auto_update_enabled, disabled: @self_update_problem.present? && !@setting.auto_update_enabled? %> <%= t(".auto_update") %></label>
        <%= form.submit t("common.save"), class: "btn btn-sm" %>
      <% end %>
      <p class="text-xs"><%= @self_update_problem ? t(".auto_update_problems.#{@self_update_problem.first}", **@self_update_problem.last) : t(".auto_update_hint_html") %></p>
    <% end %>
    <p>Kamal Web <%= KamalWeb::VERSION %> · Kamal <%= Gem.loaded_specs["kamal"]&.version %> · Rails <%= Rails.version %> · Ruby <%= RUBY_VERSION %></p>
  </div>
</div>
</div>
