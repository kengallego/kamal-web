<div id="project_activity_<%= project.id %>">
  <% if (operation = project.active_operation) %>
    <%= link_to project_command_run_path(project, operation), class: "mt-4 flex items-center gap-3 rounded-lg border border-info/30 bg-info/10 px-4 py-2 text-sm text-info hover:bg-info/20" do %>
      <span class="size-2 animate-pulse rounded-full bg-info"></span>
      <%= t(".running", command: operation.command.label, status: t("statuses.#{operation.status}"), destination: destination_label(operation.destination)) %>
      <span class="ml-auto text-xs text-info/70"><%= t(".view_output") %></span>
    <% end %>
  <% end %>
</div>
