<%# Theme and language switches, used in the sidebar and on the sign-in page. %>
<div class="flex flex-wrap items-center gap-2 text-xs">
  <div class="flex rounded-lg border border-line p-0.5" role="group" aria-label="<%= t(".theme") %>">
    <% Preferences::THEMES.each do |theme| %>
      <%= button_to t(".themes.#{theme}"), preferences_path, method: :patch, params: { theme: theme },
        class: [ "cursor-pointer rounded-md px-2 py-0.5", current_theme == theme ? "bg-subtle text-foreground" : "text-muted hover:text-body" ],
        form: { data: { turbo: false } }, "aria-pressed": current_theme == theme %>
    <% end %>
  </div>
  <div class="flex rounded-lg border border-line p-0.5" role="group" aria-label="<%= t(".language") %>">
    <% I18n.available_locales.each do |locale| %>
      <%= button_to locale.to_s.upcase, preferences_path, method: :patch, params: { locale: locale },
        class: [ "cursor-pointer rounded-md px-2 py-0.5", I18n.locale == locale ? "bg-subtle text-foreground" : "text-muted hover:text-body" ],
        form: { data: { turbo: false } }, "aria-pressed": I18n.locale == locale, lang: locale %>
    <% end %>
  </div>
</div>
