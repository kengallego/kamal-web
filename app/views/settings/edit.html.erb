<% content_for :title, "Settings" %>
<h1 class="mb-6 text-xl font-semibold text-zinc-100">Settings</h1>

<div class="max-w-3xl space-y-6">
  <div class="card">
    <div class="card-header">
      <div>
        <h2 class="card-title">Status board</h2>
        <p class="text-xs text-zinc-500">A read-only page for a TV or for your team, with deploy status and server health. Anyone with the link can see it.</p>
      </div>
    </div>
    <div class="card-body space-y-4">
      <%= form_with model: @setting, url: settings_path, method: :patch, class: "flex items-center gap-3" do |form| %>
        <label class="flex items-center gap-2 text-sm"><%= form.check_box :status_board_enabled %> Enabled</label>
        <%= form.submit "Save", class: "btn btn-sm" %>
      <% end %>

      <% if @setting.status_board_enabled? %>
        <% url = status_board_url(@setting.status_board_token) %>
        <div class="flex gap-2">
          <input type="text" readonly value="<%= url %>" class="input font-mono text-xs">
          <button class="btn" data-controller="clipboard" data-clipboard-text-value="<%= url %>" data-action="clipboard#copy">Copy</button>
          <%= link_to "Open", url, target: "_blank", class: "btn" %>
        </div>
        <%= button_to "Regenerate URL", regenerate_status_board_token_settings_path, class: "btn btn-sm", form: { data: { turbo_confirm: "The current URL will stop working." } } %>
      <% end %>
    </div>
  </div>

  <div class="card card-body text-sm text-zinc-400 space-y-1">
    <p class="font-medium text-zinc-200">Instance</p>
    <p>Kamal <%= Gem.loaded_specs["kamal"]&.version %> · Rails <%= Rails.version %> · Ruby <%= RUBY_VERSION %></p>
    <p>Password reset by email: <%= Rails.configuration.x.password_reset_enabled ? "enabled" : "disabled (set SMTP_ADDRESS)" %></p>
  </div>
</div>
