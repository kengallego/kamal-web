<div id="project_activity_<%= project.id %>">
  <% if (operation = project.active_operation) %>
    <%= link_to project_command_run_path(project, operation), class: "mt-4 flex items-center gap-3 rounded-lg border border-sky-500/30 bg-sky-500/10 px-4 py-2 text-sm text-sky-200 hover:bg-sky-500/20" do %>
      <span class="size-2 animate-pulse rounded-full bg-sky-400"></span>
      <%= t(".running", command: operation.command.label, status: t("statuses.#{operation.status}"), destination: destination_label(operation.destination)) %>
      <span class="ml-auto text-xs text-sky-300/70"><%= t(".view_output") %></span>
    <% end %>
  <% end %>
</div>
