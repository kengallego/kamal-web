<% content_for :title, t("common.dashboard") %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="text-xl font-semibold text-foreground"><%= t("common.dashboard") %></h1>
  <div class="flex gap-2">
    <%= button_to t("common.scan_this_server"), discovery_path, class: "btn", title: t(".scan_title") %>
    <%= link_to t("common.new_project"), new_project_path, class: "btn btn-primary" %>
  </div>
</div>

<% if @projects.empty? %>
  <div class="card card-body py-16 text-center">
    <h2 class="text-lg font-semibold text-foreground"><%= t(".empty_title") %></h2>
    <p class="mx-auto mt-2 max-w-md text-sm text-muted">
      <%= t(".empty_html") %>
    </p>
    <%= link_to t(".add_first"), new_project_path, class: "btn btn-primary mt-6" %>
  </div>
<% else %>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @projects.each do |project| %>
      <%= link_to project_path(project), class: "card block p-4 hover:border-faint" do %>
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <h2 class="truncate font-semibold text-foreground"><%= project.name %></h2>
            <p class="truncate text-xs text-muted"><%= project.source_description %></p>
          </div>
          <% if project.sync_error.present? %>
            <span class="badge badge-danger"><%= t(".sync_error") %></span>
          <% elsif (operation = project.active_operation) %>
            <span class="badge badge-info"><%= t(".operation_running", command: operation.command.label.downcase) %></span>
          <% end %>
        </div>

        <div class="mt-4 space-y-2">
          <% project.destinations.each do |destination| %>
            <% deploy = project.last_deploy(destination) %>
            <div class="flex items-center justify-between gap-3 text-sm">
              <span class="shrink-0 text-body"><%= destination_label(destination) %></span>
              <span class="flex min-w-0 flex-wrap items-center justify-end gap-x-2 text-right text-xs text-muted">
                <% if deploy %>
                  <%= short_sha(deploy.git_revision) %> · <%= time_ago(deploy.created_at) %> <%= status_badge(deploy.status) %>
                <% else %>
                  <%= t("common.never_deployed") %>
                <% end %>
              </span>
            </div>
          <% end %>
        </div>

        <% if (metrics = @latest_metrics[project.id]).present? %>
          <div class="mt-4 grid grid-cols-3 gap-3 border-t border-line pt-3 text-xs text-muted">
            <% { t("common.cpu") => metrics.filter_map(&:cpu_percent).max, t("common.ram") => metrics.filter_map(&:memory_percent).max, t("common.disk") => metrics.filter_map(&:disk_percent).max }.each do |label, value| %>
              <div>
                <div class="mb-1 flex justify-between"><span><%= label %></span><span><%= value ? "#{value.round}%" : "–" %></span></div>
                <%= meter(value) %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="card mt-8">
    <div class="card-header"><h2 class="card-title"><%= t("common.recent_activity") %></h2></div>
    <%= render "command_runs/table", runs: @recent_runs, show_project: true %>
  </div>
<% end %>
