# Copy to .env and fill in. .env is ignored by git.

# The IP of the server Kamal Web runs on, usually one of your Kamal servers.
KAMAL_WEB_SERVER=

# The password to create the first account with, at least 12 characters.
# Once an account exists it no longer signs anyone in.
KAMAL_WEB_PASSWORD=

# Optional: also ask for a code from an authenticator app, when creating the
# first account and from accounts without an app of their own. Generate the
# secret with bin/totp-secret.
# KAMAL_WEB_TOTP_SECRET=

# Optional: only allow these IPs or networks to open the dashboard
# (comma-separated). The deploy webhook and status board work from anywhere.
# KAMAL_WEB_ALLOWED_IPS=203.0.113.7,198.51.100.0/24

# Optional: a domain pointing at the server. Without one, Kamal Web is served at
# https://kamal.<server-ip-with-dashes>.sslip.io
# KAMAL_WEB_HOST=kamal.example.com

# Optional: the user Kamal connects as, if your servers don't use root.
# KAMAL_WEB_SSH_USER=deploy

# Optional: only connect to servers whose SSH host key you trusted in Servers,
# instead of trusting each server's key the first time Kamal Web connects.
# KAMAL_WEB_SSH_HOST_KEYS=strict

# Optional: build the image on the server. Much faster from an Apple Silicon Mac.
# KAMAL_WEB_BUILD_ON_SERVER=true
