<div class="mb-8 flex flex-wrap items-center justify-between gap-x-5 gap-y-4">
  <div class="min-w-0 flex-1 basis-60">
    <% if @eyebrow %><p class="section-label mb-3"><%= @eyebrow %></p><% end %>
    <h1 class="page-title break-words"><%= @title %></h1>
    <% if @description %><p class="mt-2 max-w-2xl break-words [overflow-wrap:anywhere] text-sm leading-relaxed text-muted"><%= @description %></p><% end %>
  </div>
  <% if content.present? %><div class="flex flex-wrap items-center gap-2"><%= content %></div><% end %>
</div>
