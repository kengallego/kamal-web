<% content_for :title, "#{t("common.commands")} · #{@project.name}" %>
<%= render "projects/header", project: @project, destination: @destination %>

<div data-controller="filter">
<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
<p class="text-sm text-muted">
  <%= t(".intro_html", destination: tag.span(destination_label(@destination), class: "text-body")) %>
</p>
<input type="search" class="filter-input" placeholder="<%= t('ui.search_commands') %>" aria-label="<%= t('ui.search_commands') %>" data-filter-target="input" data-action="input->filter#filter">
</div>

<% unavailable = [] %>
<div class="space-y-8">
  <% CommandCatalog.grouped.each do |group, commands| %>
    <% blocked, commands = commands.partition { |command| !@project.allows_command?(command) } %>
    <% unavailable.concat(blocked) %>
    <% next if commands.empty? %>
    <section data-filter-target="group">
      <h2 class="mb-3 text-sm font-semibold text-body"><%= CommandCatalog.group_label(group) %></h2>
      <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
        <% commands.each do |command| %>
          <%= form_with url: project_command_runs_path(@project), class: "card flex flex-col gap-4 p-5",
            data: (command.mutating? ? command_confirm(@project, @destination, t(".confirm", command: command.label, destination: destination_label(@destination))) : {}).merge(filter_target: 'item', filter_text: "#{command.label} #{command.key} #{command.description}") do |form| %>
            <%= hidden_field_tag :kind, command.key, id: nil %>
            <%= hidden_field_tag :destination, @destination, id: nil %>

            <div class="flex items-start justify-between gap-2">
              <div>
                <p class="font-medium text-foreground"><%= command.label %></p>
                <p class="font-mono text-xs text-muted">kamal <%= command.arguments(command.fields.to_h { |f| [ f.name, f.required ? "…" : "" ] }).join(" ") rescue command.key.tr("_", " ") %></p>
              </div>
              <% if command.mutating? %><span class="badge badge-warning"><%= t(".changes_servers") %></span><% end %>
            </div>

            <% if command.description %>
              <p class="text-xs text-muted"><%= command.description %></p>
            <% end %>

            <% command.fields.each do |field| %>
              <% field_id = "command_#{command.key}_#{field.name}" %>
              <% if field.type == :boolean %>
                <label class="flex items-center gap-2 text-sm text-body">
                  <%= check_box_tag "options[#{field.name}]", "1", false, class: "accent-accent", id: field_id %>
                  <%= field.label %>
                </label>
                <% next %>
              <% end %>
              <div>
                <label class="label" for="<%= field_id %>"><%= field.label %></label>
                <% case field.type %>
                <% when :number %>
                  <%= number_field_tag "options[#{field.name}]", nil, min: 1, max: 5000, placeholder: field.placeholder, class: "input", id: field_id %>
                <% when :host %>
                  <%= select_tag "options[#{field.name}]", options_for_select(@config.all_hosts), include_blank: t(".default_hosts"), class: "input", id: field_id %>
                <% when :accessory %>
                  <%= select_tag "options[#{field.name}]", options_for_select(@config.accessories.keys),
                    include_blank: (field.required ? false : t(".all_accessories")), class: "input", id: field_id %>
                <% else %>
                  <%= text_field_tag "options[#{field.name}]", nil, required: field.required, placeholder: field.placeholder, class: "input", id: field_id %>
                <% end %>
              </div>
            <% end %>

            <div class="mt-auto pt-1">
                <%= form.submit t("common.run"), class: "btn btn-sm" %>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
<p class="rounded-2xl border border-dashed border-strong-line px-6 py-12 text-center text-muted" hidden data-filter-target="empty" role="status"><%= t('ui.no_results') %></p>
</div>

<% if unavailable.any? %>
  <details class="mt-8 rounded-lg border border-line p-4 text-sm">
    <summary class="cursor-pointer text-muted"><%= t(".more_commands", count: unavailable.size) %></summary>
    <p class="mt-3 text-muted">
      <%= t(".unavailable_html", link: link_to(t(".add_repository"), edit_project_path(@project), class: "underline hover:text-body")) %>
    </p>
    <div class="mt-3 flex flex-wrap gap-2">
      <% unavailable.each do |command| %>
        <span class="rounded-md border border-line px-2 py-1 text-xs text-muted"><%= command.label %></span>
      <% end %>
    </div>
  </details>
<% end %>
