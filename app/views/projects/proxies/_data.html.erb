<%= turbo_frame_tag "proxy_data" do %>
  <%= render Ui::PanelComponent.new(class: 'mb-6') do %>
    <div class="card-header"><h2 class="card-title"><%= t(".routes") %></h2></div>
    <% if @routes.empty? %>
      <p class="px-4 py-6 text-center text-sm text-muted"><%= t(".no_routes", host: @host) %></p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="table">
          <thead><tr><th><%= t(".service") %></th><th><%= t("common.host") %></th><th><%= t(".path") %></th><th><%= t(".target") %></th><th><%= t(".state") %></th><th>TLS</th></tr></thead>
          <tbody>
            <% @routes.each do |route| %>
              <tr>
                <td class="text-foreground"><%= route.service %></td>
                <td class="text-body"><%= route.host %></td>
                <td class="font-mono text-xs text-muted"><%= route.path %></td>
                <td class="font-mono text-xs text-muted"><%= route.target %></td>
                <td><span class="badge <%= route.state.casecmp?("running") ? "badge-success" : "badge-warning" %>"><%= route.state %></span></td>
                <td><span class="badge <%= route.tls.casecmp?("yes") ? "badge-success" : "badge-neutral" %>"><%= route.tls %></span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>

  <% total = @traffic.size %>
  <% durations = @traffic.map(&:duration_ms).sort %>
  <div class="mb-6 grid gap-3 sm:grid-cols-4">
    <% [
      [ t(".requests_1h"), total ],
      [ t(".errors_5xx"), @traffic.count { |r| r.status >= 500 } ],
      [ t(".median"), total.positive? ? "#{durations[total / 2]} ms" : "–" ],
      [ t(".p95"), total.positive? ? "#{durations[(total * 0.95).floor.clamp(0, total - 1)]} ms" : "–" ]
    ].each do |label, value| %>
      <%= render Ui::PanelComponent.new(class: 'p-4') do %>
        <p class="label"><%= label %></p>
        <p class="text-xl font-semibold text-foreground"><%= value %></p>
      <% end %>
    <% end %>
  </div>

  <%= render Ui::PanelComponent.new(class: 'mb-6') do %>
    <div class="card-header">
      <h2 class="card-title"><%= t(".traffic") %></h2>
      <div class="flex items-center gap-3 text-xs text-muted">
        <% { "2xx" => "bg-success", "3xx" => "bg-info", "4xx" => "bg-warning", "5xx" => "bg-danger" }.each do |label, color| %>
          <span class="flex items-center gap-1"><span class="inline-block h-2 w-2 rounded-sm <%= color %>"></span><%= label %></span>
        <% end %>
      </div>
    </div>
    <div class="card-body">
      <% if @chart.empty? %>
        <p class="py-6 text-center text-sm text-muted"><%= t(".no_requests") %></p>
      <% else %>
        <% colors = { "2xx" => "var(--ui-success)", "3xx" => "var(--ui-info)", "4xx" => "var(--ui-warning)", "5xx" => "var(--ui-danger)" } %>
        <% bar = 10 %>
        <% height = 120.0 %>
        <svg viewBox="0 0 <%= @chart.minutes * bar %> <%= height.to_i %>" preserveAspectRatio="none" class="h-32 w-full" role="img" aria-label="<%= t(".chart_label") %>">
          <% @chart.buckets.each_with_index do |bucket, index| %>
            <g>
              <title><%= bucket.time.strftime("%H:%M") %>: <%= bucket.counts.map { |status_class, count| "#{count} #{status_class}" }.join(", ") %></title>
              <rect x="<%= index * bar %>" y="0" width="<%= bar %>" height="<%= height.to_i %>" fill="transparent" />
              <% y = height %>
              <% TrafficChart::CLASSES.each do |status_class| %>
                <% count = bucket.counts[status_class] %>
                <% next if count.zero? %>
                <% h = (count.to_f / @chart.peak * (height - 4)).round(2) %>
                <% y -= h %>
                <rect x="<%= index * bar + 1 %>" y="<%= y.round(2) %>" width="<%= bar - 2 %>" height="<%= h %>" fill="<%= colors[status_class] %>" />
              <% end %>
            </g>
          <% end %>
        </svg>
        <div class="mt-1 flex justify-between text-xs text-faint">
          <span><%= @chart.buckets.first.time.strftime("%H:%M") %></span>
          <span><%= t(".peak", count: @chart.peak) %></span>
          <span><%= @chart.buckets.last.time.strftime("%H:%M") %></span>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= render Ui::PanelComponent.new do %>
    <div class="card-header">
      <h2 class="card-title"><%= t(".recent_requests") %></h2>
      <span class="text-xs text-muted"><%= t(".latest_300") %></span>
    </div>
    <% if @requests.empty? %>
      <p class="px-4 py-6 text-center text-sm text-muted"><%= t(".no_requests") %></p>
    <% else %>
      <div class="max-h-[60vh] overflow-auto">
        <table class="table">
          <thead class="sticky top-0 bg-surface"><tr><th><%= t(".time") %></th><th><%= t("common.status") %></th><th><%= t(".method") %></th><th><%= t("common.host") %></th><th><%= t(".path") %></th><th><%= t("common.duration") %></th><th><%= t(".service") %></th></tr></thead>
          <tbody>
            <% @requests.each do |request| %>
              <tr>
                <td class="whitespace-nowrap text-xs text-muted"><%= request.time&.strftime("%H:%M:%S") %></td>
                <td><span class="badge <%= request.status >= 500 ? "badge-danger" : request.status >= 400 ? "badge-warning" : request.status >= 300 ? "badge-info" : "badge-success" %>"><%= request.status %></span></td>
                <td class="text-xs text-muted"><%= request.method %></td>
                <td class="text-xs text-body"><%= request.host %></td>
                <td class="max-w-md truncate font-mono text-xs text-body" title="<%= request.path %>"><%= request.path %></td>
                <td class="whitespace-nowrap text-xs text-muted"><%= request.duration_ms %> ms</td>
                <td class="text-xs text-muted"><%= request.service %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
<% end %>
