<div class="mb-8 flex flex-wrap items-start justify-between gap-5">
  <div class="min-w-0">
    <% if @eyebrow %><p class="section-label mb-2"><%= @eyebrow %></p><% end %>
    <h1 class="page-title break-words"><%= @title %></h1>
    <% if @description %><p class="mt-2 max-w-2xl break-words [overflow-wrap:anywhere] text-sm leading-relaxed text-muted"><%= @description %></p><% end %>
  </div>
  <% if content.present? %><div class="flex flex-wrap items-center gap-2 sm:pt-1"><%= content %></div><% end %>
</div>
