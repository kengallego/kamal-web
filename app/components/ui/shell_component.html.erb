<a href="#main-content" class="skip-link"><%= t('ui.skip_navigation') %></a>
<div class="flex min-h-screen">
  <aside class="sticky top-0 hidden h-screen w-60 shrink-0 flex-col border-r border-line bg-surface px-4 pt-7 pb-4 lg:flex">
    <div class="mb-9 flex items-center justify-between gap-2 px-3">
      <%= link_to root_path, class: 'flex items-center gap-2.5 text-foreground' do %>
        <span class="grid size-8 place-items-center rounded-[10px] bg-action text-white"><%= render Ui::IconComponent.new(name: :cube, size: 21) %></span>
        <span class="whitespace-nowrap text-[15px] font-semibold tracking-tight">Kamal Web</span>
      <% end %>
    </div>
    <%= render Ui::NavigationComponent.new(projects: @projects, setting: @setting) %>
  </aside>
  <div class="min-w-0 flex-1">
    <header class="sticky top-0 z-20 flex h-16 items-center justify-between gap-4 border-b border-line bg-surface px-5 sm:px-8 lg:px-10">
      <div class="flex min-w-0 items-center gap-3 text-xs">
        <%= link_to root_path, class: 'flex items-center gap-2 font-semibold text-foreground lg:hidden', aria: { label: 'Kamal Web' } do %><span class="text-accent"><%= render Ui::IconComponent.new(name: :cube, size: 21) %></span><span class="hidden sm:inline">Kamal Web</span><% end %>
        <span class="hidden text-muted lg:inline"><%= t('ui.workspace') %></span>
        <span class="text-strong-line"><%= render Ui::IconComponent.new(name: :chevron, size: 13) %></span>
        <span class="truncate font-medium text-foreground"><%= helpers.content_for(:title).presence || t('common.dashboard') %></span>
      </div>
      <div class="hidden items-center gap-2 text-[11px] text-muted lg:flex"><%= render Ui::IconComponent.new(name: :server, size: 15) %><%= t('ui.infrastructure') %></div>
      <details class="relative lg:hidden">
        <summary class="btn btn-sm list-none" aria-label="<%= t('layouts.application.menu') %>"><%= render Ui::IconComponent.new(name: :menu, size: 17) %><%= t('layouts.application.menu') %></summary>
        <div class="absolute right-0 z-30 mt-4 flex max-h-[80dvh] w-72 max-w-[calc(100vw-2.5rem)] flex-col overflow-y-auto rounded-xl border border-line bg-surface p-4 shadow-xl">
          <%= render Ui::NavigationComponent.new(projects: @projects, setting: @setting) %>
        </div>
      </details>
    </header>
    <main id="main-content" class="mx-auto max-w-[1440px] px-5 py-8 sm:px-8 lg:px-10 lg:py-10">
      <%= render 'shared/flash' %>
      <%= content %>
    </main>
  </div>
</div>
