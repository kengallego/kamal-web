<div class="stat-item">
  <div class="flex items-center gap-2 text-muted">
    <span class="hidden sm:inline"><%= render Ui::IconComponent.new(name: @icon, size: 15) %></span>
    <p class="text-[11px] sm:text-xs"><%= @label %></p>
  </div>
  <p class="mt-3 text-3xl leading-none font-medium tracking-tight text-foreground tabular-nums sm:text-4xl"><%= @value %></p>
  <% if @caption %><p class="mt-2.5 hidden text-xs text-muted sm:block"><%= @caption %></p><% end %>
</div>
