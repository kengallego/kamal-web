<%= form_with model: [ @project, variable ], class: "card card-body max-w-xl space-y-4" do |form| %>
  <%= form_errors(variable) %>
  <div>
    <%= form.label :key, "Name", class: "label" %>
    <%= form.text_field :key, required: true, class: "input font-mono", placeholder: "KAMAL_REGISTRY_PASSWORD" %>
  </div>
  <div>
    <%= form.label :value, class: "label" %>
    <%= form.text_area :value, value: nil, rows: 3, class: "input font-mono", autocomplete: "off", placeholder: variable.persisted? ? "Leave empty to keep the current value" : "" %>
  </div>
  <div>
    <%= form.label :destination, class: "label" %>
    <%= form.select :destination, [ [ "All destinations", "" ] ] + @project.destinations.compact.map { |d| [ d, d ] }, {}, class: "input" %>
  </div>
  <div class="flex gap-3">
    <%= form.submit "Save", class: "btn btn-primary" %>
    <%= link_to "Cancel", project_settings_path(@project), class: "btn" %>
  </div>
<% end %>
