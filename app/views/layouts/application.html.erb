<!DOCTYPE html>
<html class="h-full" lang="<%= I18n.locale %>"<%= %( data-theme="#{current_theme}").html_safe unless current_theme == 'system' %>>
  <head>
    <title><%= [ content_for(:title), 'Kamal Web' ].compact.join(' · ') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Kamal Web">
    <meta name="color-scheme" content="<%= { 'light' => 'light', 'dark' => 'dark' }.fetch(current_theme, 'light dark') %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, 'data-turbo-track': 'reload' %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="h-full">
    <% if authenticated? %>
      <%= render Ui::ShellComponent.new(projects: Project.ordered, setting: Setting.instance) do %>
        <%= yield %>
      <% end %>
      <%= render 'shared/typed_confirm' %>
    <% else %>
      <main id="main-content" class="grid min-h-full place-items-center px-5 py-12">
        <div class="w-full max-w-sm">
          <div class="mb-9 flex items-center justify-center gap-3">
            <span class="grid size-10 place-items-center rounded-xl bg-action text-white"><%= render Ui::IconComponent.new(name: :cube, size: 25) %></span>
            <span class="text-xl font-semibold tracking-tight text-foreground">Kamal Web</span>
            <%= render Ui::ThemeSwitcherComponent.new %>
          </div>
          <%= render 'shared/flash' %>
          <%= yield %>
        </div>
      </main>
    <% end %>
  </body>
</html>
