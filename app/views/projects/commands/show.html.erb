<% content_for :title, "Commands · #{@project.name}" %>
<%= render "projects/header", project: @project, destination: @destination %>

<p class="mb-4 text-sm text-zinc-500">
  Commands run against <span class="text-zinc-300"><%= destination_label(@destination) %></span>.
  Only one command that changes servers can run at a time per project.
</p>

<% unavailable = [] %>
<div class="space-y-8">
  <% CommandCatalog.grouped.each do |group, commands| %>
    <% blocked, commands = commands.partition { |command| !@project.allows_command?(command) } %>
    <% unavailable.concat(blocked) %>
    <% next if commands.empty? %>
    <section>
      <h2 class="mb-3 text-sm font-semibold text-zinc-300"><%= CommandCatalog::GROUPS[group] %></h2>
      <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
        <% commands.each do |command| %>
          <%= form_with url: project_command_runs_path(@project), class: "card flex flex-col gap-3 p-4",
            data: (command.mutating? ? { turbo_confirm: "#{command.label} on #{destination_label(@destination)}?" } : {}) do |form| %>
            <%= hidden_field_tag :kind, command.key, id: nil %>
            <%= hidden_field_tag :destination, @destination, id: nil %>

            <div class="flex items-start justify-between gap-2">
              <div>
                <p class="font-medium text-zinc-100"><%= command.label %></p>
                <p class="font-mono text-xs text-zinc-500">kamal <%= command.arguments(command.fields.to_h { |f| [ f.name, f.required ? "…" : "" ] }).join(" ") rescue command.key.tr("_", " ") %></p>
              </div>
              <% if command.mutating? %><span class="badge badge-warning">changes servers</span><% end %>
            </div>

            <% if command.description %>
              <p class="text-xs text-zinc-400"><%= command.description %></p>
            <% end %>

            <% command.fields.each do |field| %>
              <% if field.type == :boolean %>
                <label class="flex items-center gap-2 text-sm text-zinc-300">
                  <%= check_box_tag "options[#{field.name}]", "1", false, class: "accent-emerald-500", id: nil %>
                  <%= field.label %>
                </label>
                <% next %>
              <% end %>
              <div>
                <label class="label"><%= field.label %></label>
                <% case field.type %>
                <% when :code %>
                  <%= text_area_tag "options[#{field.name}]", nil, rows: 4, required: field.required, placeholder: field.placeholder, class: "input font-mono", id: nil %>
                <% when :number %>
                  <%= number_field_tag "options[#{field.name}]", nil, min: 1, max: 5000, placeholder: field.placeholder, class: "input", id: nil %>
                <% when :host %>
                  <%= select_tag "options[#{field.name}]", options_for_select(@config.all_hosts), include_blank: "Default hosts", class: "input", id: nil %>
                <% when :accessory %>
                  <%= select_tag "options[#{field.name}]", options_for_select(@config.accessories.keys),
                    include_blank: (field.required ? false : "All accessories"), class: "input", id: nil %>
                <% else %>
                  <%= text_field_tag "options[#{field.name}]", nil, required: field.required, placeholder: field.placeholder, class: "input", id: nil %>
                <% end %>
              </div>
            <% end %>

            <div class="mt-auto pt-1">
                <%= form.submit "Run", class: command.mutating? ? "btn btn-primary" : "btn" %>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>

<% if unavailable.any? %>
  <details class="mt-8 rounded-lg border border-zinc-800 p-4 text-sm">
    <summary class="cursor-pointer text-zinc-400">More commands available with the app's code (<%= unavailable.size %>)</summary>
    <p class="mt-3 text-zinc-500">
      Kamal UI found this app from its running containers, so it can manage what's running but doesn't have the code or secrets to build and deploy it.
      <%= link_to "Add the git repository", edit_project_path(@project), class: "underline hover:text-zinc-300" %> to enable:
    </p>
    <div class="mt-3 flex flex-wrap gap-2">
      <% unavailable.each do |command| %>
        <span class="rounded-md border border-zinc-800 px-2 py-1 text-xs text-zinc-400"><%= command.label %></span>
      <% end %>
    </div>
  </details>
<% end %>
