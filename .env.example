# Copy to .env and fill in. .env is ignored by git.

# The IP of the server Kamal UI runs on, usually one of your Kamal servers.
KAMAL_UI_SERVER=

# The password to sign in, at least 12 characters.
KAMAL_UI_PASSWORD=

# Optional: a domain pointing at the server. Without one, Kamal UI is served at
# https://kamal.<server-ip-with-dashes>.sslip.io
# KAMAL_UI_HOST=kamal.example.com

# Optional: the user Kamal connects as, if your servers don't use root.
# KAMAL_UI_SSH_USER=deploy

# Optional: build the image on the server. Much faster from an Apple Silicon Mac.
# KAMAL_UI_BUILD_ON_SERVER=true
