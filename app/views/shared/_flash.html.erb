<% if notice.present? %>
  <div class="mb-4 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm text-emerald-300"><%= notice %></div>
<% end %>
<% if alert.present? %>
  <div class="mb-4 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-2 text-sm text-red-300"><%= alert %></div>
<% end %>
