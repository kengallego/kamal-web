<% content_for :title, "#{@session.label} · #{@project.name}" %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= render "projects/header", project: @project %>

<div data-controller="console" data-console-session-id-value="<%= @session.id %>" data-console-messages-value="<%= t(".messages").to_json %>">
  <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <h2 class="text-lg font-semibold text-foreground"><%= @session.label %></h2>
      <span class="badge badge-neutral" data-console-target="status"><%= t(".connecting") %></span>
    </div>
    <div class="flex items-center gap-3 text-sm text-muted">
      <span><%= destination_label(@session.destination) %> · <span class="font-mono"><%= @session.host || t(".primary_host") %></span></span>
      <%= link_to t(".new_session"), project_console_sessions_path(@project, destination: @session.destination), class: "btn" %>
    </div>
  </div>

  <div class="h-[70vh] overflow-hidden rounded-xl border border-line bg-[#111722] p-2" data-console-target="screen"></div>
  <p class="mt-2 text-xs text-muted"><%= t(".hint") %></p>
</div>
