<% content_for :title, "#{@run.command.label} · #{@project.name}" %>
<%= render "projects/header", project: @project %>
<%= turbo_stream_from @run %>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <div>
    <div class="flex items-center gap-3">
      <h2 class="text-lg font-semibold text-foreground"><%= @run.command.label %></h2>
      <%= render "command_runs/status", run: @run %>
    </div>
    <p class="mt-1 text-sm text-muted">
      <%= destination_label(@run.destination) %> · <%= t(".from", source: @run.triggered_by) %> · <%= l(@run.created_at, format: :long) %>
      <% if @run.git_revision %> · <span class="font-mono"><%= short_sha(@run.git_revision) %></span><% end %>
      <% if @run.exit_code %> · <%= t(".exit_code", code: @run.exit_code) %><% end %>
    </p>
  </div>
  <div class="flex gap-2">
    <% if @run.active? && @run.follow? %>
      <%= button_to t(".stop_following"), cancel_project_command_run_path(@project, @run), class: "btn btn-danger" %>
    <% elsif @run.active? %>
      <%= button_to t("common.cancel"), cancel_project_command_run_path(@project, @run), class: "btn btn-danger", form: { data: { turbo_confirm: t(".confirm_cancel") } } %>
    <% else %>
      <%= button_to t(".run_again"), project_command_runs_path(@project), params: { kind: @run.kind, destination: @run.destination }.merge(@run.options.transform_keys { |key| "options[#{key}]" }),
        class: "btn", form: (@run.mutating? ? { data: command_confirm(@project, @run.destination, t(".confirm_again", command: @run.command.label)) } : {}) %>
    <% end %>
  </div>
</div>

<div class="<%= "grid gap-6 lg:grid-cols-4" if @run.mutating? %>">
  <div class="min-w-0 lg:col-span-3">
    <pre id="run_output_<%= @run.id %>" class="terminal" data-controller="autoscroll"><%= @run.output %></pre>
    <% if @run.output.bytesize >= CommandRun::OUTPUT_LIMIT %>
      <p class="mt-2 text-xs text-warning">
        <%= t(".truncated", size: number_to_human_size(CommandRun::OUTPUT_LIMIT)) %><%= t(".still_streaming") if @run.follow? %>
      </p>
    <% end %>
  </div>

  <% if @run.mutating? %>
    <%= render Ui::PanelComponent.new(class: 'self-start') do %>
      <div class="card-header"><h2 class="card-title"><%= t(".containers") %></h2></div>
      <%= turbo_frame_tag "containers", src: project_containers_path(@project, destination: @run.destination, run_id: @run.id), data: { controller: "poll-frame" } do %>
        <p class="px-4 py-4 text-sm text-muted"><%= t("common.loading") %></p>
      <% end %>
    <% end %>
  <% end %>
</div>
