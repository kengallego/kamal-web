<% content_for :title, "#{t("common.monitoring")} · #{@project.name}" %>
<%= render "projects/header", project: @project %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <p class="text-sm text-muted">
    <% if @project.monitoring_enabled? %>
      <%= t(".sampled") %>
    <% else %>
      <%= t(".off") %>
    <% end %>
  </p>
  <div class="flex items-center gap-2">
    <div class="flex rounded-lg border border-line bg-surface p-1">
      <% Projects::MonitoringController::RANGES.each_key do |range| %>
        <%= link_to t(".ranges.#{range}"), project_monitoring_path(@project, range: range), class: ["rounded-md px-3 py-1.5 text-xs font-medium", range == @range ? "bg-accent-soft text-accent" : "text-muted hover:text-foreground"], aria: { current: ("page" if range == @range) } %>
      <% end %>
    </div>
    <%= button_to t(".refresh"), project_monitoring_path(@project), class: "btn" %>
  </div>
</div>

<% if @hosts.empty? %>
  <%= render Ui::PanelComponent.new(class: 'card-body text-center text-sm text-muted') do %><%= t(".no_hosts") %><% end %>
<% end %>

<div class="space-y-6">
  <% @hosts.each do |host| %>
    <% samples = @samples[host] || [] %>
    <% history = @history[host] || [] %>
    <% latest = samples.last %>
    <%= render Ui::PanelComponent.new do %>
      <div class="card-header">
        <h2 class="card-title font-mono"><%= host %></h2>
        <span class="text-xs text-muted">
          <% if latest %><%= t(".updated", time: time_ago(latest.collected_at)) %><% else %><%= t(".no_samples") %><% end %>
        </span>
      </div>

      <% if latest&.error %>
        <div class="card-body text-sm text-danger"><%= latest.error %></div>
      <% elsif latest %>
        <div class="card-body grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <% [
            [ t("common.cpu"), latest.cpu_percent, "#{latest.cpu_percent&.round || "–"}%", history.map(&:cpu_percent) ],
            [ t(".load"), latest.load_percent, t(".cores", load: latest.load_1&.round(2), count: latest.cpu_count), history.map(&:load_percent) ],
            [ t(".memory"), latest.memory_percent, "#{number_to_human_size(latest.memory_used)} / #{number_to_human_size(latest.memory_total)}", history.map(&:memory_percent) ],
            [ t("common.disk"), latest.disk_percent, "#{number_to_human_size(latest.disk_used)} / #{number_to_human_size(latest.disk_total)}", history.map(&:disk_percent) ]
          ].each do |label, percent, detail, series| %>
            <div class="rounded-lg border border-line p-3">
              <div class="flex items-baseline justify-between">
                <span class="label mb-0"><%= label %></span>
                <span class="text-lg font-semibold text-foreground"><%= percent ? "#{percent.round}%" : "–" %></span>
              </div>
              <p class="mb-2 text-xs text-muted"><%= detail %></p>
              <%= meter(percent) %>
              <div class="mt-3 flex h-10 items-end gap-px" title="<%= t(".ranges_long.#{@range}") %>">
                <% bucketed(series).each do |value| %>
                  <% value = value.to_f.clamp(0, 100) %>
                  <span class="flex-1 rounded-sm <%= value >= 90 ? "bg-danger/70" : value >= 70 ? "bg-warning/70" : "bg-success/50" %>" style="height: <%= [ value, 3 ].max %>%"></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <% if latest.containers.any? %>
          <div class="overflow-x-auto border-t border-line">
            <table class="table">
              <thead><tr><th><%= t(".container") %></th><th><%= t(".image") %></th><th><%= t("common.status") %></th><th><%= t(".ports") %></th><th></th></tr></thead>
              <tbody>
                <% latest.containers.each do |container| %>
                  <tr>
                    <td class="font-mono text-xs text-body">
                      <span class="flex items-center gap-2">
                        <span class="size-2 shrink-0 rounded-full <%= container["State"] == "running" ? "bg-success" : "bg-faint" %>"></span>
                        <%= container["Names"] %>
                      </span>
                    </td>
                    <td class="font-mono text-xs text-muted"><%= container["Image"].to_s.truncate(60) %></td>
                    <td class="text-xs text-muted"><%= container["Status"] %></td>
                    <td class="font-mono text-xs text-muted"><%= container["Ports"] %></td>
                    <td class="text-right">
                      <%= button_to t(".logs"), project_command_runs_path(@project), class: "btn btn-sm",
                        params: { kind: "app_logs", destination: @project.destination_for_host(host),
                          "options[host]" => host, "options[container_id]" => container["Names"], "options[lines]" => 200, "options[follow]" => "1" } %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
