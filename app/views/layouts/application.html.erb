<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= [ content_for(:title), "Kamal Web" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Kamal Web">
    <meta name="color-scheme" content="dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <% if authenticated? %>
      <div class="flex min-h-full">
        <aside class="hidden w-60 shrink-0 flex-col border-r border-zinc-800 bg-zinc-950 p-4 lg:flex">
          <%= link_to root_path, class: "mb-6 flex items-center gap-2 px-2" do %>
            <span class="grid size-7 place-items-center rounded-lg bg-emerald-500 text-sm font-black text-zinc-950">K</span>
            <span class="font-semibold text-zinc-100">Kamal Web</span>
          <% end %>

          <nav class="space-y-1">
            <%= nav_link "Dashboard", root_path %>
          </nav>

          <div class="mt-6 mb-2 flex items-center justify-between px-3">
            <span class="text-xs font-medium uppercase tracking-wide text-zinc-500">Projects</span>
            <%= link_to "+", new_project_path, class: "text-zinc-500 hover:text-zinc-100", title: "New project" %>
          </div>
          <nav class="space-y-1">
            <% Project.ordered.each do |project| %>
              <%= nav_link project.name, project_path(project), active: request.path.start_with?(project_path(project)) %>
            <% end %>
          </nav>

          <div class="mt-auto space-y-1 border-t border-zinc-800 pt-4">
            <%= nav_link "Settings", edit_settings_path %>
            <%= button_to "Sign out", session_path, method: :delete, class: "w-full rounded-lg px-3 py-1.5 text-left text-sm text-zinc-500 hover:bg-zinc-900 hover:text-zinc-100 cursor-pointer" %>
          </div>
        </aside>

        <div class="min-w-0 flex-1">
          <header class="flex items-center justify-between border-b border-zinc-800 px-4 py-3 lg:hidden">
            <%= link_to "Kamal Web", root_path, class: "font-semibold" %>
            <details class="relative">
              <summary class="btn btn-sm list-none">Menu</summary>
              <div class="absolute right-0 z-10 mt-2 w-56 space-y-1 rounded-xl border border-zinc-800 bg-zinc-900 p-2">
                <%= nav_link "Dashboard", root_path %>
                <% Project.ordered.each do |project| %>
                  <%= nav_link project.name, project_path(project) %>
                <% end %>
                <%= nav_link "Settings", edit_settings_path %>
                <%= button_to "Sign out", session_path, method: :delete, class: "w-full rounded-lg px-3 py-1.5 text-left text-sm text-zinc-400 cursor-pointer" %>
              </div>
            </details>
          </header>

          <main class="mx-auto max-w-7xl px-4 py-6 lg:px-8">
            <%= render "shared/flash" %>
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <main class="grid min-h-full place-items-center px-4 py-12">
        <div class="w-full max-w-sm">
          <div class="mb-8 flex items-center justify-center gap-2">
            <span class="grid size-9 place-items-center rounded-xl bg-emerald-500 font-black text-zinc-950">K</span>
            <span class="text-xl font-semibold text-zinc-100">Kamal Web</span>
          </div>
          <%= render "shared/flash" %>
          <%= yield %>
        </div>
      </main>
    <% end %>
  </body>
</html>
