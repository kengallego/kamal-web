<% if notice.present? %>
  <div class="mb-4 rounded-lg border border-success/30 bg-success/10 px-4 py-2 text-sm text-success"><%= notice %></div>
<% end %>
<% if alert.present? %>
  <div class="mb-4 rounded-lg border border-danger/30 bg-danger/10 px-4 py-2 text-sm text-danger"><%= alert %></div>
<% end %>
