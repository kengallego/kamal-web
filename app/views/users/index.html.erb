<% content_for :title, "Users" %>
<div class="mb-6 flex items-center justify-between">
  <h1 class="text-xl font-semibold text-zinc-100">Users</h1>
  <%= link_to "Add user", new_user_path, class: "btn btn-primary" %>
</div>

<div class="card">
  <table class="table">
    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th></th></tr></thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td class="text-zinc-100"><%= user.name %></td>
          <td class="text-zinc-400"><%= user.email_address %></td>
          <td><span class="badge <%= user.admin? ? "badge-success" : user.deployer? ? "badge-info" : "badge-neutral" %>"><%= user.role %></span></td>
          <td>
            <div class="flex justify-end gap-2">
              <%= link_to "Edit", edit_user_path(user), class: "btn btn-sm" %>
              <% unless user == current_user %>
                <%= button_to "Delete", user_path(user), method: :delete, class: "btn btn-sm btn-danger", form: { data: { turbo_confirm: "Delete #{user.email_address}?" } } %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="card card-body mt-6 text-sm text-zinc-400">
  <p><span class="font-medium text-zinc-200">viewer</span>: sees everything and runs read-only commands (logs, details, audit).</p>
  <p><span class="font-medium text-zinc-200">deployer</span>: also deploys, rolls back, runs commands in app containers and manages the deploy lock.</p>
  <p><span class="font-medium text-zinc-200">admin</span>: also manages projects, secrets, users, accessories, the proxy and server setup.</p>
</div>
