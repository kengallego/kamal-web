<%= form_with model: user, class: "card card-body max-w-xl space-y-4" do |form| %>
  <%= form_errors(user) %>
  <div>
    <%= form.label :name, class: "label" %>
    <%= form.text_field :name, class: "input" %>
  </div>
  <div>
    <%= form.label :email_address, "Email", class: "label" %>
    <%= form.email_field :email_address, required: true, class: "input" %>
  </div>
  <div>
    <%= form.label :role, class: "label" %>
    <%= form.select :role, User::ROLES, {}, class: "input" %>
  </div>
  <div>
    <%= form.label :password, class: "label" %>
    <%= form.password_field :password, required: user.new_record?, minlength: 10, maxlength: 72, autocomplete: "new-password", class: "input",
      placeholder: user.persisted? ? "Leave empty to keep the current password" : "At least 10 characters" %>
  </div>
  <div class="flex gap-3">
    <%= form.submit "Save", class: "btn btn-primary" %>
    <%= link_to "Cancel", users_path, class: "btn" %>
  </div>
<% end %>
