<% content_for :title, t(".title") %>

<%= render Ui::PanelComponent.new(class: 'card-body') do %>
  <h1 class="mb-6 text-lg font-semibold text-foreground"><%= t(".title") %></h1>

  <% if (problem = AccessPassword.problem) %>
    <p class="rounded-lg border border-danger/30 bg-danger/10 p-3 text-sm text-danger"><%= problem %></p>
  <% else %>
    <%= form_with url: session_url, class: "space-y-4" do |form| %>
      <%# Lets password managers tell this instance apart from others. %>
      <%= hidden_field_tag :username, "kamal-web@#{request.host}", autocomplete: "username", id: nil %>
      <div>
        <%= form.label :password, t(".password"), class: "label" %>
        <%= form.password_field :password, required: true, autofocus: true, autocomplete: "current-password", class: "input" %>
      </div>

      <% if AccessPassword.two_factor? %>
        <div>
          <%= form.label :code, t(".code"), class: "label" %>
          <%= form.text_field :code, required: true, inputmode: "numeric", pattern: "[0-9 ]{6,7}", maxlength: 7, autocomplete: "one-time-code", class: "input font-mono tracking-widest" %>
        </div>
      <% end %>

      <%= form.submit t(".title"), class: "btn btn-primary w-full" %>
    <% end %>

    <p class="mt-4 text-center text-xs text-muted"><%= t(".hint_html") %></p>
  <% end %>
<% end %>
