#!/bin/bash -e
# Prints a shell command that adds Kamal UI's public key to the current user's
# authorized_keys, unless it is already there. `kamal authorize` runs it on the
# server as Kamal's SSH user:
#   docker exec <kamal-ui container> bin/authorize-key | sh
key=$(cat "$(dirname "$0")/../storage/kamal-ui.pub")
echo "mkdir -p -m 700 ~/.ssh && touch ~/.ssh/authorized_keys && (grep -qxF '$key' ~/.ssh/authorized_keys || echo '$key' >> ~/.ssh/authorized_keys) && echo \"Kamal UI can SSH in as \$(whoami)\""
