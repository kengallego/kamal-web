<% content_for :title, "#{t("common.monitoring")} · #{@project.name}" %>
<%= render "projects/header", project: @project %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <p class="text-sm text-muted">
    <% if @project.monitoring_enabled? %>
      <%= t(".sampled") %>
    <% else %>
      <%= t(".off") %>
    <% end %>
  </p>
  <div class="flex items-center gap-2">
    <div class="flex rounded-lg border border-line bg-surface p-1">
      <% Projects::MonitoringController::RANGES.each_key do |range| %>
        <%= link_to t(".ranges.#{range}"), project_monitoring_path(@project, range: range), class: ["rounded-md px-3 py-1.5 text-xs font-medium", range == @range ? "bg-accent-soft text-accent" : "text-muted hover:text-foreground"], aria: { current: ("page" if range == @range) } %>
      <% end %>
    </div>
    <%= button_to t(".refresh"), project_monitoring_path(@project), class: "btn" %>
  </div>
</div>

<% if @hosts.empty? %>
  <%= render Ui::PanelComponent.new(class: 'card-body text-center text-sm text-muted') do %><%= t(".no_hosts") %><% end %>
<% end %>

<div class="space-y-6">
  <% @hosts.each do |host| %>
    <% samples = @samples[host] || [] %>
    <% history = @history[host] || [] %>
    <% latest = samples.last %>
    <%= render Ui::PanelComponent.new do %>
      <div class="card-header">
        <h2 class="card-title font-mono"><%= host %></h2>
        <span class="text-xs text-muted">
          <% if latest %><%= t(".updated", time: time_ago(latest.collected_at)) %><% else %><%= t(".no_samples") %><% end %>
        </span>
      </div>

      <% if latest&.error %>
        <div class="card-body text-sm text-danger"><%= latest.error %></div>
      <% elsif latest %>
        <div class="card-body grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <% [
            [ t("common.cpu"), latest.app_cpu_percent, latest.cpu_percent, nil, history.map(&:app_cpu_percent), history.map(&:cpu_percent) ],
            [ t(".load"), latest.load_percent, nil, t(".cores", load: latest.load_1&.round(2), count: latest.cpu_count), history.map(&:load_percent), [], true ],
            [ t(".memory"), latest.app_memory_percent, latest.memory_percent, latest.app_memory_used && "#{number_to_human_size(latest.app_memory_used)} / #{number_to_human_size(latest.memory_total)}", history.map(&:app_memory_percent), history.map(&:memory_percent) ],
            [ t("common.disk"), latest.app_disk_percent, latest.disk_percent, latest.app_disk_used && "#{number_to_human_size(latest.app_disk_used)} / #{number_to_human_size(latest.disk_total)}", history.map(&:app_disk_percent), history.map(&:disk_percent) ]
          ].each do |label, percent, total, detail, series, total_series, machine_only| %>
            <div class="rounded-lg border border-line p-3">
              <div class="flex items-start justify-between">
                <div class="label mb-0 flex items-center gap-1.5">
                  <span><%= label %></span>
                  <% if label == t(".load") %>
                    <% tooltip_id = "load-help-#{host.parameterize}" %>
                    <span class="group relative inline-flex">
                      <button type="button" class="inline-flex size-4 cursor-help items-center justify-center rounded-full text-faint hover:text-body" aria-label="<%= t('.load_help') %>" aria-describedby="<%= tooltip_id %>">
                        <%= render Ui::IconComponent.new(name: :info, size: 14) %>
                      </button>
                      <span id="<%= tooltip_id %>" role="tooltip" class="pointer-events-none invisible absolute left-0 top-full z-30 mt-2 w-56 rounded-lg border border-line bg-surface px-3 py-2 text-xs font-normal leading-relaxed text-body shadow-sm group-hover:visible group-focus-within:visible"><%= t('.load_hint') %></span>
                    </span>
                  <% end %>
                </div>
                <span class="flex min-h-12 flex-col items-end tabular-nums">
                  <% unless machine_only %><span class="text-lg font-semibold text-success"><%= percent ? "#{percent.round}%" : "–" %></span><% end %>
                  <span class="<%= machine_only ? 'text-lg font-semibold' : 'mt-0.5 text-[11px]' %> text-success/50"><%= (machine_only ? percent : total)&.then { |value| "#{value.round}%" } || "–" %></span>
                </span>
              </div>
              <p class="mb-2 min-h-4 text-xs text-muted"><%= detail %></p>
              <%= render Ui::MeterComponent.new(percent: (percent unless machine_only), total_percent: machine_only ? percent : total) %>
              <div class="mt-3 flex h-10 items-end gap-px" title="<%= t(".ranges_long.#{@range}") %>" aria-hidden="true">
                <% bucketed(series).zip(bucketed(total_series)).each do |value, total_value| %>
                  <% value, total_value = nil, value if machine_only %>
                  <span class="relative h-full flex-1">
                    <% if total_value %><span class="absolute inset-x-0 bottom-0 rounded-sm bg-success/25" style="height: <%= total_value.clamp(0, 100) %>%"></span><% end %>
                    <% if value %><span class="absolute inset-x-0 bottom-0 rounded-sm bg-success" style="height: <%= value.clamp(0, 100) %>%"></span><% end %>
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <% if latest.containers.any? %>
          <div class="overflow-x-auto border-t border-line">
            <table class="table">
              <thead><tr><th><%= t(".container") %></th><th><%= t(".image") %></th><th><%= t("common.status") %></th><th><%= t(".ports") %></th><th></th></tr></thead>
              <tbody>
                <% latest.containers.each do |container| %>
                  <tr>
                    <td class="font-mono text-xs text-body">
                      <span class="flex items-center gap-2">
                        <span class="size-2 shrink-0 rounded-full <%= container["State"] == "running" ? "bg-success" : "bg-faint" %>"></span>
                        <%= container["Names"] %>
                      </span>
                    </td>
                    <td class="font-mono text-xs text-muted"><%= container["Image"].to_s.truncate(60) %></td>
                    <td class="text-xs text-muted"><%= container["Status"] %></td>
                    <td class="font-mono text-xs text-muted"><%= container["Ports"] %></td>
                    <td class="text-right">
                      <% destination = container.dig("Labels", "destination") || @project.destination_for_host(host) %>
                      <%= link_to t(".logs"), project_logs_path(@project, destination: destination, options: { host: host, container_id: container["Names"] }), class: "btn btn-sm" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
